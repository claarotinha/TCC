  guardaRegistro: {fileID: 4200000034}
  guardaRegistroParado: {fileID: 21300000, guid: 34ef38e60f0e505f948cd84fa73d42d1, type: 3}
  guardaRegistroBloqueio: {fileID: 21300000, guid: 34ef38e60f0e505f948cd84fa73d42d1, type: 3}
  cabacaVaziaBusca: {fileID: 11400000, guid: f0c6e92250400ab42871c53f7ebf8161, type: 2}
  cabacaCheiaBusca: {fileID: 11400000, guid: aa17c14a2df34f789bd319f7012a0031, type: 2}
  itemLaco: {fileID: 11400000, guid: 1083a2fec9775e2c9829a6a959228da0, type: 2}
  itemCanhoto: {fileID: 11400000, guid: 8c45070f39885b448afa8363afcb0774, type: 2}
  alcanceInteracao: 3
  aguaFuncionario:
  - personagem: "Funcion\xE1rio"
    texto: "\xC9 o que tem nessa rodada. Volta quando chamar."
  aguaAntesEscolha:
  - personagem: "M\xE3e"
    texto: "D\xEA a ele primeiro."
  - personagem: Pai
    texto: "Eu j\xE1 tomei. Eu vi foi tu dando a tua parte."
  - personagem: Luzia
    texto: "Leve pra tua m\xE3e. Eu espero a outra vez."
  aguaMae:
  - personagem: Zefinha
    texto: "Beba, mainha. Depois n\xF3s busca mais."
  - personagem: "M\xE3e"
    texto: "S\xF3 um pouco. Num vou tomar tudo."
  - personagem: Zefinha
    texto: "Eu t\xF4 vendo a senhora tremer."
  aguaLuzia:
  - personagem: Zefinha
    texto: "A senhora num t\xE1 conseguindo ficar em p\xE9."
  - personagem: Luzia
    texto: "Tua m\xE3e t\xE1 esperando, menina."
  - personagem: Zefinha
    texto: Eu digo a ela. Tome.
  meninoApresentacao:
  - personagem: Zefinha
    texto: Desculpa. Eu pensei...
  - personagem: "Crian\xE7a"
    texto: "T\xE1 procurando algu\xE9m?"
  - personagem: Zefinha
    texto: "Minha irm\xE3."
  - personagem: "Crian\xE7a"
    texto: "Eu t\xF4 esperando meu tio."
  meninoEspera:
  - personagem: "Crian\xE7a"
    texto: "Desde que trouxeram n\xF3s. Minha m\xE3e disse que ele vinha com as ferramenta."
  - personagem: Zefinha
    texto: "E tua m\xE3e?"
  - personagem: "Crian\xE7a"
    texto: "T\xE1 ali. Eu num posso me afastar muito."
  meninoNome:
  - personagem: Zefinha
    texto: "Maria Severina. Se tu escutar algu\xE9m chamar, me avisa."
  - personagem: "Crian\xE7a"
    texto: Eu aviso. Mas tem muita Maria aqui.
  meninoSaida:
  - personagem: Zefinha
    texto: Eu preciso ir. Tomara que teu tio chegue.
  registroInicio:
  - personagem: Zefinha
    texto: "Minha irm\xE3 foi com o outro grupo antes de n\xF3s entrar. O nome dela
      \xE9 Maria Severina."
  - personagem: "Escriv\xE3o"
    texto: Sobrenome?
  - personagem: ACOMPANHANTE
    texto: "N\xF3s pode dizer o nome do pai e da m\xE3e. Ela foi separada da fam\xEDlia
      no bloqueio."
  - personagem: "Escriv\xE3o"
    texto: "Essa rela\xE7\xE3o aqui \xE9 de quem entrou por este port\xE3o. N\xE3o
      achei."
  - personagem: Zefinha
    texto: "Ent\xE3o olhe a outra."
  - personagem: "Escriv\xE3o"
    texto: "A outra n\xE3o veio pra minha m\xE3o."
  - personagem: Zefinha
    texto: "Mas o senhor sabe quem t\xE1 com ela?"
  - personagem: "Escriv\xE3o"
    texto: "Pergunte no posto de sa\xEDda. Quando o movimento acabar."
  registroMae:
  - personagem: "M\xE3e"
    texto: "Minha filha num \xE9 movimento. Eu vi levarem ela."
  - personagem: "Escriv\xE3o"
    texto: Eu estou dizendo onde perguntar.
  - personagem: "M\xE3e"
    texto: "E l\xE1 v\xE3o mandar perguntar aqui de novo?"
  registroLuzia:
  - personagem: Luzia
    texto: "Pelo menos escreva que tem uma m\xE3e procurando."
  - personagem: "Escriv\xE3o"
    texto: "N\xE3o tenho como atestar o que n\xE3o vi."
  - personagem: Luzia
    texto: "Eu num pedi que inventasse. Escreva o que a menina t\xE1 dizendo."
  panelaInicio:
  - personagem: Fiscal
    texto: "Veio buscar o pano? Pegue e v\xE1. Num vou parar o servi\xE7o pra tu
      remexer tudo."
  - personagem: Zefinha (em pensamentos)
    texto: "O la\xE7o dela... E esse papel veio do carro. Tem um lugar escrito."
  panelaLaco:
  - personagem: Zefinha
    texto: "\xC9 dela. Eu quero isso aqui."
  - personagem: Fiscal
    texto: Pois leve.
  panelaCanhoto:
  - personagem: Zefinha
    texto: "Esse papel tamb\xE9m veio com n\xF3s."
  - personagem: Fiscal
    texto: "Ent\xE3o \xE9 isso. V\xE1."
  - personagem: Zefinha (em pensamentos)
    texto: Lagoa do Meio. Eu preciso guardar esse nome.
  opcoesLuziaInicio:
  - "Buscar \xE1gua"
  - Relembrar a chegada
  - Sair
  opcoesAgua:
  - "Dar a \xE1gua \xE0 m\xE3e"
  - "Dar a \xE1gua a Luzia"
  opcoesMenino:
  - "Perguntar h\xE1 quanto tempo espera"
  - Dizer o nome de Mariquinha
  - Sair
  opcoesRegistro:
  - Relembrar a conversa
  - Sair
  opcoesPanela:
  - "Recuperar o peda\xE7o do la\xE7o"
  - Guardar o canhoto do encaminhamento
  objetivosBusca:
  - "Fale com Luzia para buscar \xE1gua."
  - "V\xE1 \xE0 distribui\xE7\xE3o de \xE1gua e fale com o funcion\xE1rio."
  - "Volte ao abrigo e entregue a por\xE7\xE3o de \xE1gua \xE0 m\xE3e ou a Luzia."
  - "Procure a mesa dos nomes. Voc\xEA tamb\xE9m pode conversar com o menino."
  - "Retorne \xE0 panela dos pertences, junto da mesa da revista."
  - "Procurar quem viu o grupo que passou antes da entrada da fam\xEDlia."
  perguntaAgua: "A caba\xE7a tem \xE1gua para uma por\xE7\xE3o. A quem entregar?"
  perguntaPanela: O fiscal permite levar uma coisa. O que guardar?
  setorBusca: {fileID: 4300000000}
  areaRaimundo: {fileID: 4300000011}
  areaLavadeira: {fileID: 4300000023}
  areaPanoLavagem: {fileID: 4300000027}
  areaLembranca: {fileID: 4300000058}
  areaPatio: {fileID: 4300000061}
  areaPanoAtendimento: {fileID: 4300000065}
