  tempoFade: 0.7
  tempoPlano: 1.2
  tempoSeparacao: 2.5
  tempoCarroca: 2.8
  antesSeparacao:
  - personagem: Cabo
    texto: "Parados! Ningu\xE9m passa. Larguem as trouxas e fiquem na fila. Agora
      andem atr\xE1s de mim."
  - personagem: "M\xE3e"
    texto: "Fique perto da sua irm\xE3, Josefa."
  barreira:
  - personagem: "M\xE3e"
    texto: "Aquela ali tamb\xE9m \xE9 minha! Olhe pra ela!"
  - personagem: Cabo
    texto: "J\xE1 mandei andar."
  depoisSeparacao:
  - personagem: Pai
    texto: Zulema... Com a Josefa. Fica com a Josefa.
  promessa:
    personagem: Mariquinha
    texto: Zefinha! Tu prometeu!
  semPromessa:
    personagem: Mariquinha
    texto: Num deixa eles me levar sozinha!
  respostaZefinha:
    personagem: Zefinha
    texto: "Eu t\xF4 vendo tu! Eu vou te achar!"
  entrada:
  - personagem: Fiscal
    texto: "Ferramenta fica aqui. Depois v\xEA o que devolve."
  - personagem: Pai
    texto: "O fac\xE3o \xE9 de trabalho. Eu preciso dele."
  - personagem: Fiscal
    texto: "Aqui o servi\xE7o \xE9 o que mandarem fazer."
  - personagem: "M\xE3e"
    texto: Disseram que aqui tinha socorro. Onde atendem meu marido?
  - personagem: Fiscal
    texto: Primeiro passa pela revista. Depois pergunta.
  revista:
  - personagem: Fiscal
    texto: "O restante dos pertences fica retido. A caba\xE7a voc\xEAs pedem na distribui\xE7\xE3o
      da \xE1gua."
  - personagem: Fiscal
    texto: E esse caderno aqui?
  - personagem: Zefinha
    texto: "\xC9 meu."
  - personagem: "M\xE3e"
    texto: Deixe a menina com o caderno dela.
  - personagem: Fiscal
    texto: Pois pegue. E desocupe a mesa.
  abrigo:
  - personagem: Luzia
    texto: Encoste ele aqui. Esse lado pega sombra um pouco mais cedo.
  - personagem: "M\xE3e"
    texto: "N\xF3s veio atr\xE1s de comida e trabalho. Ningu\xE9m falou que iam fechar
      n\xF3s aqui."
  - personagem: Luzia
    texto: "Tem gente que chega pensando que vai descansar e seguir viagem. Depois
      descobre o port\xE3o."
  - personagem: "M\xE3e"
    texto: "Josefa, veja o pano que Luzia deixou pra n\xF3s. Seu pai precisa de ajuda."
  exames:
  - area: {fileID: 4100000078}
    titulo: Esteira
    texto: "Uma esteira dividida no ch\xE3o do abrigo. O pai precisa descansar o
      ombro."
  - area: {fileID: 4100000140}
    titulo: Cerca
    texto: "A cerca divide o setor. A rua est\xE1 perto, mas a passagem \xE9 vigiada."
  - area: {fileID: 4100000146}
    titulo: Fila
    texto: "Outras fam\xEDlias aguardam diante da mesa. H\xE1 pertences reunidos
      junto dela."
  - area: {fileID: 4100000143}
    titulo: "Port\xE3o"
    texto: "O port\xE3o \xE9 vis\xEDvel daqui. O guarda n\xE3o deixa a fam\xEDlia
      voltar para a rua."
  objetivoBusca: Descobrir para onde levaram Mariquinha.
  objetivoLaco: "Clique no peda\xE7o do la\xE7o que caiu no ch\xE3o."
  botoesEtapa2:
  - {fileID: 3000000032}
  - {fileID: 3000000049}
  - {fileID: 3000000083}
  - {fileID: 3600000108}
  areaAgua: {fileID: 4200000023}
  areaMae: {fileID: 4200000047}
  areaMenino: {fileID: 4200000039}
  areaRegistro: {fileID: 4200000031}
  areaPanela: {fileID: 4200000048}
  meninoBusca: {fileID: 4200000037}
  meninoFimPasso: {fileID: 4200000051}
  panelaBusca: {fileID: 4100000067}
  panelaNoChao: {fileID: 4200000053}
  panelaRecolhida: {fileID: 4200000055}
  lacoNoChao: {fileID: 4200000057}
  luziaRepouso: {fileID: 4200000059}
  seguidoraLuzia: {fileID: 4200000049}
  seguidoraMae: {fileID: 467838416}
  canhotoCenario: {fileID: 4200000043}
  cabacaMesa: {fileID: 4200000016}
  guardaRegistro: {fileID: 4200000034}
  guardaRegistroParado: {fileID: 21300000, guid: 34ef38e60f0e505f948cd84fa73d42d1, type: 3}
  guardaRegistroBloqueio: {fileID: 21300000, guid: 34ef38e60f0e505f948cd84fa73d42d1, type: 3}
  cabacaVaziaBusca: {fileID: 11400000, guid: f0c6e92250400ab42871c53f7ebf8161, type: 2}
  cabacaCheiaBusca: {fileID: 11400000, guid: aa17c14a2df34f789bd319f7012a0031, type: 2}
  itemLaco: {fileID: 11400000, guid: 1083a2fec9775e2c9829a6a959228da0, type: 2}
  itemCanhoto: {fileID: 11400000, guid: 8c45070f39885b448afa8363afcb0774, type: 2}
  alcanceInteracao: 4.6
  aguaFuncionario:
  - personagem: "Funcion\xE1ria"
    texto: "Ponha a caba\xE7a aqui. \xC9 o que tem nessa rodada. Volte quando chamar."
  - personagem: Zefinha
    texto: "\xC9 t\xE3o pouco\u2026 Vou levar pro abrigo."
  aguaAntesEscolha:
  - personagem: "M\xE3e"
    texto: "D\xEA a ele primeiro."
  - personagem: Pai
    texto: "Eu j\xE1 tomei. Eu vi foi tu dando a tua parte."
  - personagem: Luzia
    texto: "Leve pra tua m\xE3e. Eu espero a outra vez."
  aguaMae:
  - personagem: Zefinha
    texto: "Beba, mainha. Depois n\xF3s busca mais."
  - personagem: "M\xE3e"
    texto: "S\xF3 um pouco. Num vou tomar tudo."
  - personagem: Zefinha
    texto: "Eu t\xF4 vendo a senhora tremer."
  aguaLuzia:
  - personagem: Zefinha
    texto: "A senhora num t\xE1 conseguindo ficar em p\xE9."
  - personagem: Luzia
    texto: "Tua m\xE3e t\xE1 esperando, menina."
  - personagem: Zefinha
    texto: Eu digo a ela. Tome.
  meninoApresentacao:
  - personagem: Zefinha
    texto: "Desculpa. De longe, pensei que fosse minha irm\xE3."
  - personagem: "Crian\xE7a"
    texto: "T\xE1 procurando algu\xE9m?"
  - personagem: Zefinha
    texto: "Minha irm\xE3. E tu?"
  - personagem: "Crian\xE7a"
    texto: Meu tio. Mainha disse que ele vinha com as ferramentas.
  meninoEspera:
  - personagem: Zefinha
    texto: Tu fica esperando aqui o dia todo?
  - personagem: "Crian\xE7a"
    texto: A gente espera muita coisa aqui.
  - personagem: Zefinha
    texto: E essa lata?
  - personagem: "Crian\xE7a"
    texto: "\xC9 da comida. Mainha disse pra num perder. Se chamarem, eu preciso
      t\xE1 com ela."
  meninoNome:
  - personagem: Zefinha
    texto: "Maria Severina. Se tu escutar algu\xE9m chamar, me avisa."
  - personagem: "Crian\xE7a"
    texto: Eu aviso. Mas tem muita Maria aqui.
  meninoSaida:
  - personagem: Zefinha
    texto: Eu preciso ir. Tomara que teu tio chegue.
  registroInicio:
  - personagem: Zefinha
    texto: "E a minha irm\xE3? Maria Severina. Foi separada de n\xF3s antes do port\xE3o."
  - personagem: "Escriv\xE3o"
    texto: "Agora eu t\xF4 atendendo esta fila. Leve os panos. Depois procure no
      posto de sa\xEDda."
  - personagem: ACOMPANHANTE
    texto: "Foi l\xE1 que mandaram perguntar aqui."
  - personagem: "Escriv\xE3o"
    texto: "J\xE1 disse onde deve ir."
  registroMae:
  - personagem: "M\xE3e"
    texto: "Prometeram procurar. Agora tem mais servi\xE7o no meio."
  - personagem: "Escriv\xE3o"
    texto: Desocupe a mesa, senhora.
  registroLuzia:
  - personagem: Luzia
    texto: Ao menos guarde o nome da menina. Maria Severina.
  - personagem: "Escriv\xE3o"
    texto: Eu ouvi. Agora desocupe.
  panelaInicio:
  - personagem: Zefinha
    texto: Esse canhoto veio com o carro que levou o outro grupo?
  - personagem: Fiscal
    texto: "Num mexa nas coisas. J\xE1 pegou os panos, siga pro servi\xE7o."
  - personagem: Zefinha (em pensamentos)
    texto: A marca parece a do carro. Posso perguntar pelo lugar escrito no papel
      antes de ir.
  panelaLaco:
  - personagem: Zefinha
    texto: "\xC9 dela. Eu quero isso aqui."
  - personagem: Fiscal
    texto: Pois leve.
  panelaCanhoto:
  - personagem: Zefinha
    texto: Foi pra onde mandaram aquele grupo?
  - personagem: Fiscal
    texto: "Lagoa do Meio. Est\xE1 escrito a\xED. Leve esse canhoto e v\xE1."
  - personagem: Zefinha (em pensamentos)
    texto: "Lagoa do Meio. Vou guardar esse nome. O papel num diz se chegaram l\xE1."
  opcoesLuziaInicio:
  - "Buscar \xE1gua"
  - Relembrar a chegada
  - Sair
  opcoesAgua:
  - "Dar a \xE1gua \xE0 m\xE3e"
  - "Dar a \xE1gua a Luzia"
  opcoesMenino:
  - "Perguntar h\xE1 quanto tempo espera"
  - Dizer o nome de Mariquinha
  - Sair
  opcoesRegistro:
  - Relembrar a conversa
  - Sair
  opcoesPanela:
  - Perguntar pelo encaminhamento
  - Seguir com os panos
  objetivosBusca:
  - "Fale com Luzia para buscar \xE1gua."
  - "V\xE1 \xE0 distribui\xE7\xE3o e pergunte como receber \xE1gua."
  - "Selecione a caba\xE7a cheia e volte ao abrigo para decidir com quem dividir."
  - "Procure a mesa dos nomes. Voc\xEA tamb\xE9m pode conversar com o menino."
  - "Veja o canhoto junto \xE0 mesa dos nomes antes de seguir com os panos."
  - "Leve o lote \xE0 lavadeira. Fale com Raimundo para seguir pela passagem."
  perguntaAgua: "A caba\xE7a tem \xE1gua para uma por\xE7\xE3o. A quem entregar?"
  perguntaPanela: Perguntar pelo encaminhamento ou seguir com os panos?
  setorBusca: {fileID: 4300000000}
  areaRaimundo: {fileID: 4300000011}
  areaLavadeira: {fileID: 4300000023}
  areaPanoLavagem: {fileID: 4300000027}
  areaLembranca: {fileID: 4300000058}
  areaPatio: {fileID: 4300000061}
  areaPanoAtendimento: {fileID: 4300000065}
