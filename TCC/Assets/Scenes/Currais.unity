  quartoMemoria: {fileID: 4600000028}
  areaPaginasMemoria: {fileID: 4400000105}
  mariPlanoMemoria: {fileID: 4600000031}
  cameraPlanoMemoria: {fileID: 4600000033}
  paginasMemoria:
  - personagem: "Mem\xF3ria de Zefinha"
    texto: "Dias depois. Perguntamos aos que chegavam. Ningu\xE9m trouxe Severina."
  - personagem: "Mem\xF3ria de Zefinha"
    texto: "Meses depois. Sa\xEDmos de l\xE1. Painho guardava as perguntas. Mainha
      guardava os nomes."
  - personagem: "Mem\xF3ria de Zefinha"
    texto: Mais tarde. Toda menina vista de longe fazia eu olhar outra vez. Nunca
      era ela.
  pensamentoMemoria:
    personagem: Mari (pensamento)
    texto: A bisa viveu tudo isso. E continuou procurando. Eu preciso lembrar das
      pessoas, dos nomes e do que fizeram com elas.
  chamadoPresente:
    personagem: "M\xE3e de Mari (presente)"
    texto: Maria Gabriely...
  idsPaginasMemoria:
  - currais-dias-depois
  - currais-meses-depois
  - currais-mais-tarde
  opcoesFimMemoria:
  - "Rever as p\xE1ginas"
  - Revisar as pistas
  - Voltar ao abrigo
  - Voltar ao menu
  objetivoPaginasMemoria: "Aproxime-se da esteira para acompanhar as p\xE1ginas seguintes
    da vida de Zefinha."
  objetivoFimMemoria: "A busca por Maria Severina continuou. As lembran\xE7as permanecem."
  tituloFimMemoria: Fim do Ato 2
  duracaoPaginaMemoria: 6
  leituraMinimaMemoria: 1.5
  duracaoCorteMemoria: 1.5
