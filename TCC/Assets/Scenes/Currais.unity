  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ExamineObject
  examinePanel: {fileID: 3000000053}
  examineText: {fileID: 3000000061}
  message: O guarda percorre a passagem entre os sacos. De tempos em tempos, olha
    para quem atravessa.
--- !u!114 &9933000050
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1156249495}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 01563f0e1bb2d514aba7eb7c4a3d5e20, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ExamineObject
  examinePanel: {fileID: 3000000053}
  examineText: {fileID: 3000000061}
  message: "Ele mant\xE9m o bra\xE7o ferido junto ao corpo. Com a outra m\xE3o, tenta
    firmar a carga."
--- !u!114 &9933000051
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4300000082}
  m_Enabled: 0
