  paiEntrada: {fileID: 4100000125}
  maeEntrada: {fileID: 4100000127}
  baleiaEntrada: {fileID: 4100000129}
  mariAbrigo: {fileID: 4100000131}
  paiAbrigo: {fileID: 4100000133}
  maeAbrigo: {fileID: 4100000135}
  baleiaAbrigo: {fileID: 4100000137}
  tempoFade: 0.7
  tempoPlano: 1.2
  tempoSeparacao: 2.5
  tempoCarroca: 2.8
  antesSeparacao:
  - personagem: Pai
    texto: "Devagar! Tem crian\xE7a aqui!"
  - personagem: Cabo
    texto: "Quem t\xE1 desse lado fica. Os outros acompanham o carro."
  - personagem: "M\xE3e"
    texto: "S\xE3o minhas filhas. As duas v\xEAm comigo."
  - personagem: Cabo
    texto: "Ent\xE3o segure as duas e ande."
  - personagem: Mariquinha
    texto: "Mainha! Eu t\xF4 aqui!"
  - personagem: Zefinha
    texto: Mariquinha, espera!
  barreira:
  - personagem: "M\xE3e"
    texto: "Aquela ali tamb\xE9m \xE9 minha! Olhe pra ela!"
  - personagem: Cabo
    texto: "J\xE1 mandei andar."
  depoisSeparacao:
  - personagem: Pai
    texto: Zulema... Com a Josefa. Fica com a Josefa.
  promessa:
    personagem: Mariquinha
    texto: Zefinha! Tu prometeu!
  semPromessa:
    personagem: Mariquinha
    texto: Num deixa eles me levar sozinha!
  respostaZefinha:
    personagem: Zefinha
    texto: "Eu t\xF4 vendo tu! Eu vou te achar!"
  entrada:
  - personagem: Fiscal
    texto: "Ferramenta fica aqui. Depois v\xEA o que devolve."
  - personagem: Pai
    texto: "O fac\xE3o \xE9 de trabalho."
  - personagem: Fiscal
    texto: Eu ouvi. Bote junto dos outros.
  - personagem: "M\xE3e"
    texto: Pra onde foi a outra leva? Minha filha foi nela.
  - personagem: Fiscal
    texto: Pergunte na mesa dos nomes.
  - personagem: Zefinha
    texto: Onde fica?
  - personagem: Fiscal
    texto: Depois da fila. Agora desocupe.
  revista:
  - personagem: Zefinha
    texto: "Isso \xE9 meu."
  - personagem: Fiscal
    texto: "Tudo tem dono. Agora v\xE1."
  abrigo:
  - personagem: Luzia
    texto: Encoste ele aqui. Esse lado pega sombra um pouco mais cedo.
  - personagem: "M\xE3e"
    texto: "N\xF3s tem outra menina. Levaram ela antes da entrada."
  - personagem: Luzia
    texto: "T\xE3o trazendo gente de mais de um canto. Eu pergunto na lavagem. \xC0s
      vezes o grupo passa por l\xE1 antes de seguir."
  - personagem: Zefinha
    texto: "A senhora viu uma menina igual a mim? Com vestido diferente, um la\xE7o..."
  - personagem: Luzia
    texto: "Hoje eu num vi. Mas vou escutar direito. Qual \xE9 o nome dela?"
  - personagem: Zefinha
    texto: "Maria Severina. N\xF3s chama Mariquinha."
  - personagem: Pai
    texto: "N\xF3s chega, pergunta e sai atr\xE1s dela."
  - personagem: Guarda
    texto: "Sa\xEDda s\xF3 quando chamarem."
  - personagem: Zefinha (em pensamentos)
    texto: "Eu consigo ver a rua. \xC9 ali. Mas n\xF3s num pode ir."
  exames:
  - area: {fileID: 4100000078}
    titulo: Esteira
    texto: "Uma esteira dividida no ch\xE3o do abrigo. O pai precisa descansar o
      ombro."
  - area: {fileID: 4100000140}
    titulo: Cerca
    texto: "A cerca divide o setor. A rua est\xE1 perto, mas a passagem \xE9 vigiada."
  - area: {fileID: 4100000146}
    titulo: Fila
    texto: "Outras fam\xEDlias aguardam diante da mesa. H\xE1 pertences reunidos
      junto dela."
  - area: {fileID: 4100000143}
    titulo: "Port\xE3o"
    texto: "O port\xE3o \xE9 vis\xEDvel daqui. O guarda n\xE3o deixa a fam\xEDlia
      voltar para a rua."
  objetivoBusca: Descobrir para onde levaram Mariquinha.
  objetivoLaco: "Clique no peda\xE7o do la\xE7o que caiu no ch\xE3o."
  botoesEtapa2:
  - {fileID: 3000000032}
  - {fileID: 3000000049}
  - {fileID: 3000000083}
  - {fileID: 3600000108}
  areaAgua: {fileID: 4200000023}
  areaMae: {fileID: 4200000047}
  areaMenino: {fileID: 4200000039}
