  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AreaCurrais
  titulo: "01 - Entrada e separa\xE7\xE3o"
  acontecimentos: "Chegada, escolta, separa\xE7\xE3o de Mariquinha e ferimento do
    pai."
  artesExistentes: "Cen\xE1rio, personagens e anima\xE7\xF5es originais da autora;
    rodas independentes da carro\xE7a."
  variantesPendentes: "Gestos espec\xEDficos de chamar, amparar, proteger o bra\xE7o
    e bloquear pendentes de arte aprovada. Deslocamentos usam as anima\xE7\xF5es
    existentes."
  camadas: "Fundo -120 a -80; cercas -40; abrigo -20; esteiras -10; pessoas 17 a
    28; Mari 30; objetos em m\xE3os 32 a 36."
  marcasRelacionadas:
  - {fileID: 4100000109}
  - {fileID: 4100000113}
  - {fileID: 4100000115}
  - {fileID: 4100000117}
