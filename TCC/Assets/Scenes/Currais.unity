  fade: {fileID: 3000000092}
  conversarBotao: {fileID: 3000000032}
  sairBotao: {fileID: 3000000049}
  rua: {fileID: 4100000000}
  campo: {fileID: 4100000002}
  lacoChao: {fileID: 4100000026}
  lacoPanela: {fileID: 4100000069}
  outraFila: {fileID: 4100000098}
  areaLaco: {fileID: 4100000029}
  areaLuzia: {fileID: 4100000097}
  pai: {fileID: 1156249496}
  mae: {fileID: 467838414}
  baleia: {fileID: 953090003}
  irma: {fileID: 700555846}
  cabo: {fileID: 4100000083}
  carroca: {fileID: 4100000024}
  luzia: {fileID: 4100000094}
  seguidores:
  - {fileID: 467838416}
  - {fileID: 700555848}
  - {fileID: 1156249498}
  - {fileID: 953090005}
  visualIrma: {fileID: 700555847}
  irmaFerida: {fileID: 21300000, guid: c4a40000000040008000000000000002, type: 3}
  irmaCurativo: {fileID: 21300000, guid: c6a60000000040008000000000000002, type: 3}
  cameraRua: {fileID: 4100000109}
  cameraCampo: {fileID: 4100000111}
  irmaSeparada: {fileID: 4100000113}
  irmaSaida: {fileID: 4100000115}
  caboBarreira: {fileID: 4100000117}
  carrocaSaida: {fileID: 4100000119}
  pontoColeta: {fileID: 4100000121}
  mariEntrada: {fileID: 4100000123}
  paiEntrada: {fileID: 4100000125}
  maeEntrada: {fileID: 4100000127}
  baleiaEntrada: {fileID: 4100000129}
  mariAbrigo: {fileID: 4100000131}
  paiAbrigo: {fileID: 4100000133}
  maeAbrigo: {fileID: 4100000135}
  baleiaAbrigo: {fileID: 4100000137}
  tempoFade: 0.7
  tempoPlano: 1.2
  tempoSeparacao: 2.5
  tempoCarroca: 2.8
  antesSeparacao:
  - personagem: Cabo
    texto: "Parados! Ningu\xE9m passa. Larguem as trouxas e fiquem na fila. Agora
      andem atr\xE1s de mim."
  - personagem: "M\xE3e"
    texto: "Fique perto da sua irm\xE3, Josefa."
  barreira:
  - personagem: "M\xE3e"
    texto: "Aquela ali tamb\xE9m \xE9 minha! Olhe pra ela!"
  - personagem: Cabo
    texto: "J\xE1 mandei andar."
  depoisSeparacao:
  - personagem: Pai
    texto: Zulema... Com a Josefa. Fica com a Josefa.
  promessa:
    personagem: Mariquinha
    texto: Zefinha! Tu prometeu!
  semPromessa:
    personagem: Mariquinha
    texto: Num deixa eles me levar sozinha!
  respostaZefinha:
    personagem: Zefinha
    texto: "Eu t\xF4 vendo tu! Eu vou te achar!"
  entrada:
  - personagem: Fiscal
    texto: "Ferramenta fica aqui. Depois v\xEA o que devolve."
  - personagem: Pai
    texto: "O fac\xE3o \xE9 de trabalho. Eu preciso dele."
  - personagem: Fiscal
    texto: "Aqui o servi\xE7o \xE9 o que mandarem fazer."
  - personagem: "M\xE3e"
    texto: Disseram que aqui tinha socorro. Onde atendem meu marido?
  - personagem: Fiscal
    texto: Primeiro passa pela revista. Depois pergunta.
  revista:
  - personagem: Fiscal
    texto: "O restante dos pertences fica retido. A caba\xE7a voc\xEAs pedem na distribui\xE7\xE3o
      da \xE1gua."
  - personagem: Fiscal
    texto: E esse caderno aqui?
  - personagem: Zefinha
    texto: "\xC9 meu."
  - personagem: "M\xE3e"
    texto: Deixe a menina com o caderno dela.
  - personagem: Fiscal
    texto: Pois pegue. E desocupe a mesa.
  abrigo:
  - personagem: Luzia
    texto: Encoste ele aqui. Esse lado pega sombra um pouco mais cedo.
  - personagem: "M\xE3e"
    texto: "N\xF3s veio atr\xE1s de comida e trabalho. Ningu\xE9m falou que iam fechar
      n\xF3s aqui."
  - personagem: Luzia
    texto: "Tem gente que chega pensando que vai descansar e seguir viagem. Depois
      descobre o port\xE3o."
  - personagem: "M\xE3e"
    texto: "Josefa, veja o pano que Luzia deixou pra n\xF3s. Seu pai precisa de ajuda."
  exames:
  - area: {fileID: 4100000078}
    titulo: Esteira
    texto: "Uma esteira dividida no ch\xE3o do abrigo. O pai precisa descansar o
      ombro."
  - area: {fileID: 4100000140}
    titulo: Cerca
    texto: "A cerca divide o setor. A rua est\xE1 perto, mas a passagem \xE9 vigiada."
  - area: {fileID: 4100000146}
    titulo: Fila
    texto: "Outras fam\xEDlias aguardam diante da mesa. H\xE1 pertences reunidos
      junto dela."
  - area: {fileID: 4100000143}
    titulo: "Port\xE3o"
    texto: "O port\xE3o \xE9 vis\xEDvel daqui. O guarda n\xE3o deixa a fam\xEDlia
      voltar para a rua."
  objetivoBusca: 
  objetivoLaco: 
  botoesEtapa2:
  - {fileID: 3000000032}
  - {fileID: 3000000049}
  - {fileID: 3000000083}
  - {fileID: 3600000108}
