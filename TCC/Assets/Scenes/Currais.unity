  guardaRetaguarda: {fileID: 9805000001}
  deslocamentoEscolta: {fileID: 9805000101}
  cameraRevista: {fileID: 9805000161}
  guardaSeparacao: {fileID: 9805000111}
  guardaGolpe: {fileID: 9805000121}
  paiReacao: {fileID: 9805000131}
  ordemSeparar:
  - personagem: Guarda
    texto: "Essa aqui vem comigo. A carro\xE7a t\xE1 cheia."
  - personagem: "M\xE3e"
    texto: "Ela vem com n\xF3s. S\xE3o minhas duas filhas."
  - personagem: Guarda
    texto: Eu disse que vem comigo.
  - personagem: Mariquinha
    texto: "Mainha! Eu t\xF4 aqui!"
  protestoPai:
  - personagem: Pai
    texto: Num separe minhas filhas!
  reacaoGolpe:
  - personagem: Pai
    texto: "Ah! Meu bra\xE7o\u2026"
  - personagem: "M\xE3e"
    texto: "Pare! Ele s\xF3 foi buscar a menina!"
  - personagem: Guarda
    texto: "Ent\xE3o mande ele andar."
  areaFiscalEntrada: {fileID: 4100000089}
  areaDiarioEntrada: {fileID: 9805000203}
  diarioEntrada: {fileID: 9805000200}
  diarioFalas:
  - personagem: Zefinha
    texto: "Meu caderno\u2026 Ainda bem que ele deixou eu levar."
  - personagem: "M\xE3e"
    texto: Guarde junto de tu, Josefa. Vamos acudir seu pai.
  objetivoRevista: 
  areaPanoAbrigo: {fileID: 9805000303}
  panoAbrigo: {fileID: 9805000300}
  panoNoPai: {fileID: 9805000400}
  itemPanoAbrigo: {fileID: 11400000, guid: 696180fc49fd457ead3d4ad6ee729c99, type: 2}
  panoDisponivel:
  - personagem: Luzia
    texto: "Pode levar esse pano, Josefa. D\xEA \xE0 sua m\xE3e pra ela acomodar
      o ombro dele."
  - personagem: Zefinha
    texto: Obrigada, dona Luzia.
  paiAcomodado:
  - personagem: "M\xE3e"
    texto: Isso. Segure aqui um instante.
  - personagem: Pai
    texto: "Devagar\u2026"
  - personagem: "M\xE3e"
    texto: Assim fica melhor?
  - personagem: Pai
    texto: Fica. Obrigado, minha filha.
  luziaCurral:
  - personagem: Zefinha
    texto: Por que chamam aqui de curral?
  - personagem: Luzia
    texto: "Porque juntam n\xF3s atr\xE1s da cerca e mandam quando pode passar."
  - personagem: Zefinha
    texto: Eu pensei que era um lugar pra descansar.
  - personagem: Luzia
    texto: Era o que muita gente pensava quando chegou.
  luziaSaida:
  - personagem: Zefinha
    texto: "N\xF3s pode sair para procurar ela?"
  - personagem: Luzia
    texto: "S\xF3 deixam passar quem tem ordem."
  - personagem: Zefinha
    texto: "Mas ela t\xE1 sozinha."
  - personagem: Luzia
    texto: "Eu sei, minha filha. N\xF3s vai perguntar por dentro primeiro. Na lavagem,
      nas filas\u2026 algu\xE9m pode ter visto."
  luziaIrma:
  - personagem: Zefinha
    texto: "A senhora viu minha irm\xE3? \xC9 parecida comigo."
  - personagem: Luzia
    texto: "Hoje eu num vi. Qual \xE9 o nome dela?"
  - personagem: Zefinha
    texto: "Maria Severina. N\xF3s chama Mariquinha."
  - personagem: Luzia
    texto: Vou perguntar na lavagem. Tem muita gente chegando por caminhos diferentes.
  objetivoPano: 
  apresentacaoLuziaInicio:
  - personagem: "M\xE3e"
    texto: "Com licen\xE7a\u2026 tem algum canto onde a gente possa ficar?"
  - personagem: Mulher
    texto: "Tem um espa\xE7o aqui. Encoste ele desse lado."
  - personagem: "M\xE3e"
    texto: "Obrigada. Eu sou Zulema. Essa \xE9 Josefa."
  - personagem: Mulher
    texto: Eu sou Luzia.
  apresentacaoLuziaDepoisDoNome:
  - personagem: Luzia
    texto: Tenho um pano limpo ali. Pode servir de apoio.
  - personagem: "M\xE3e"
    texto: Josefa, traga pra mim.
  apresentacaoLuziaTardia:
  - personagem: "M\xE3e"
    texto: "A senhora j\xE1 ajudou tanto\u2026 e eu nem perguntei seu nome."
  - personagem: Mulher
    texto: Eu sou Luzia. Pode contar comigo no que eu puder.
