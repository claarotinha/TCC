--- !u!114 &9911880001
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4400000012}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 01563f0e1bb2d514aba7eb7c4a3d5e20, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ExamineObject
  examinePanel: {fileID: 3000000053}
  examineText: {fileID: 3000000061}
  message: "Sobre a mesa, uma folha traz os nomes de um grupo encaminhado para fora
    do campo. Um funcion\xE1rio come\xE7a a juntar os pap\xE9is."
--- !u!114 &9911880002
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4300000008}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 01563f0e1bb2d514aba7eb7c4a3d5e20, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ExamineObject
  examinePanel: {fileID: 3000000053}
  examineText: {fileID: 3000000061}
  message: "Raimundo tenta baixar um recipiente pesado. Ele muda a posi\xE7\xE3o
    da m\xE3o, mas a al\xE7a continua apertando o mesmo lugar."
--- !u!114 &9911880011
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4400000069}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 01563f0e1bb2d514aba7eb7c4a3d5e20, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ExamineObject
  examinePanel: {fileID: 3000000053}
  examineText: {fileID: 3000000061}
  message: "Pela abertura, Zefinha v\xEA pessoas deitadas e uma trabalhadora passando
    entre elas. N\xE3o consegue ver quem est\xE1 no canto do quarto."
--- !u!114 &9911880012
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4400000037}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 01563f0e1bb2d514aba7eb7c4a3d5e20, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ExamineObject
  examinePanel: {fileID: 3000000053}
  examineText: {fileID: 3000000061}
  message: "Uma mulher repousa de lado. Ao perceber Zefinha, tenta levantar um pouco
    a cabe\xE7a."
--- !u!114 &9911880013
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4400000045}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 01563f0e1bb2d514aba7eb7c4a3d5e20, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ExamineObject
  examinePanel: {fileID: 3000000053}
  examineText: {fileID: 3000000061}
  message: "Um homem acompanha com os olhos o recipiente nas m\xE3os da trabalhadora.
    Os l\xE1bios est\xE3o ressecados."
--- !u!114 &9911880021
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4300000008}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 01563f0e1bb2d514aba7eb7c4a3d5e20, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ExamineObject
  examinePanel: {fileID: 3000000053}
  examineText: {fileID: 3000000061}
  message: "Raimundo est\xE1 perto dos baldes. Abre e fecha a m\xE3o devagar antes
    de segurar uma das al\xE7as."
--- !u!114 &9911880031
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4400000024}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 01563f0e1bb2d514aba7eb7c4a3d5e20, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ExamineObject
  examinePanel: {fileID: 3000000053}
  examineText: {fileID: 3000000061}
  message: "O escriv\xE3o confere uma rela\xE7\xE3o enquanto o fiscal re\xFAne os
    pap\xE9is para lev\xE1-los. Perto da passagem, uma trabalhadora espera a chamada
    para o servi\xE7o."
