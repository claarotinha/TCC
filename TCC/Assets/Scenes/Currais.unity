  progressoPrefab: {fileID: 8793866522150346966, guid: b6c04563513ca8f4386c9efc9f228e13, type: 3}
  inventarioPrefab: {fileID: 1997213353830323318, guid: 9467ae3681ed7a44f9278721b339ebee, type: 3}
