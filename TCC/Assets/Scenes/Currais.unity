  guardaRegistroBloqueio: {fileID: 21300000, guid: 34ef38e60f0e505f948cd84fa73d42d1, type: 3}
  cabacaVaziaBusca: {fileID: 11400000, guid: f0c6e92250400ab42871c53f7ebf8161, type: 2}
  cabacaCheiaBusca: {fileID: 11400000, guid: aa17c14a2df34f789bd319f7012a0031, type: 2}
  itemLaco: {fileID: 11400000, guid: 1083a2fec9775e2c9829a6a959228da0, type: 2}
  itemCanhoto: {fileID: 11400000, guid: 8c45070f39885b448afa8363afcb0774, type: 2}
  alcanceInteracao: 4.6
  aguaFuncionario:
  - personagem: "Funcion\xE1ria"
    texto: "Ponha a caba\xE7a aqui. \xC9 o que tem nessa rodada. Volte quando chamar."
  - personagem: Zefinha
    texto: "\xC9 t\xE3o pouco\u2026 Vou levar pro abrigo."
  aguaAntesEscolha:
  - personagem: "M\xE3e"
    texto: "D\xEA a ele primeiro."
  - personagem: Pai
    texto: "Eu j\xE1 tomei. Eu vi foi tu dando a tua parte."
  - personagem: Luzia
    texto: "Leve pra tua m\xE3e. Eu espero a outra vez."
  aguaMae:
  - personagem: Zefinha
    texto: "Beba, mainha. Depois n\xF3s busca mais."
  - personagem: "M\xE3e"
    texto: "S\xF3 um pouco. Num vou tomar tudo."
  - personagem: Zefinha
    texto: "Eu t\xF4 vendo a senhora tremer."
  aguaLuzia:
  - personagem: Zefinha
    texto: "A senhora num t\xE1 conseguindo ficar em p\xE9."
  - personagem: Luzia
    texto: "Tua m\xE3e t\xE1 esperando, menina."
  - personagem: Zefinha
    texto: Eu digo a ela. Tome.
  meninoApresentacao:
  - personagem: Zefinha
    texto: "Desculpa. De longe, pensei que fosse minha irm\xE3."
  - personagem: "Crian\xE7a"
    texto: Ela se parece contigo?
  - personagem: Zefinha
    texto: "Parece. Separaram n\xF3s na entrada. Tu tamb\xE9m t\xE1 esperando algu\xE9m?"
  - personagem: "Crian\xE7a"
    texto: Meu tio. Mainha disse que ele vinha com as ferramentas.
  meninoEspera:
  - personagem: Zefinha
    texto: Tu espera aqui faz tempo?
  - personagem: "Crian\xE7a"
    texto: Desde que o sol tava daquele lado.
  - personagem: Zefinha
    texto: "E tua m\xE3e?"
  - personagem: "Crian\xE7a"
    texto: "T\xE1 na fila. Disse pra eu ficar onde meu tio pudesse me achar."
  meninoNome:
  - personagem: Zefinha
    texto: "Minha irm\xE3 se chama Maria Severina. N\xF3s chama Mariquinha."
  - personagem: "Crian\xE7a"
    texto: "Maria Severina\u2026"
  - personagem: Zefinha
    texto: Se tu ouvir chamarem, me avisa?
  - personagem: "Crian\xE7a"
    texto: Aviso. Mas tem muita Maria aqui.
  meninoSaida:
  - personagem: Zefinha
    texto: Eu preciso ir. Tomara que teu tio chegue.
  registroInicio:
  - personagem: Zefinha
    texto: "E a minha irm\xE3? Maria Severina. Foi separada de n\xF3s antes do port\xE3o."
  - personagem: "Escriv\xE3o"
    texto: "Agora eu t\xF4 atendendo esta fila. Leve os panos. Depois procure no
      posto de sa\xEDda."
  - personagem: ACOMPANHANTE
    texto: "Foi l\xE1 que mandaram perguntar aqui."
  - personagem: "Escriv\xE3o"
    texto: "J\xE1 disse onde deve ir."
  registroMae:
  - personagem: "M\xE3e"
    texto: "Prometeram procurar. Agora tem mais servi\xE7o no meio."
  - personagem: "Escriv\xE3o"
    texto: Desocupe a mesa, senhora.
  registroLuzia:
  - personagem: Luzia
    texto: Ao menos guarde o nome da menina. Maria Severina.
  - personagem: "Escriv\xE3o"
    texto: Eu ouvi. Agora desocupe.
  panelaInicio:
  - personagem: Zefinha
    texto: Esse canhoto veio com o carro que levou o outro grupo?
  - personagem: Fiscal
    texto: "Num mexa nas coisas. J\xE1 pegou os panos, siga pro servi\xE7o."
  - personagem: Zefinha (em pensamentos)
    texto: A marca parece a do carro. Posso perguntar pelo lugar escrito no papel
      antes de ir.
  panelaLaco:
  - personagem: Zefinha
    texto: "\xC9 dela. Eu quero isso aqui."
  - personagem: Fiscal
    texto: Pois leve.
  panelaCanhoto:
  - personagem: Zefinha
    texto: Foi pra onde mandaram aquele grupo?
  - personagem: Fiscal
    texto: "Lagoa do Meio. Est\xE1 escrito a\xED. Leve esse canhoto e v\xE1."
  - personagem: Zefinha (em pensamentos)
    texto: "Lagoa do Meio. Vou guardar esse nome. O papel num diz se chegaram l\xE1."
  opcoesLuziaInicio:
  - "Buscar \xE1gua"
  - Relembrar a chegada
  - Sair
  opcoesAgua:
  - "Dar a \xE1gua \xE0 m\xE3e"
  - "Dar a \xE1gua a Luzia"
  opcoesMenino:
  - "Perguntar h\xE1 quanto tempo espera"
  - Dizer o nome de Mariquinha
  - Sair
  opcoesRegistro:
  - Relembrar a conversa
  - Sair
  opcoesPanela:
  - Perguntar pelo encaminhamento
  - Seguir com os panos
  - Voltar
  objetivosBusca:
  - 
  - 
  - 
  - 
  - 
  - 
  perguntaAgua: "A caba\xE7a tem \xE1gua para uma por\xE7\xE3o. A quem entregar?"
  perguntaPanela: Perguntar pelo encaminhamento ou seguir com os panos?
  areaPaiAbrigo: {fileID: 9955000002}
  maeCuidadoAbrigo: {fileID: 9955000011}
  cabacaComMari: {fileID: 9955000022}
  cabacaComMae: {fileID: 9955000032}
  cabacaComLuzia: {fileID: 9955000042}
  maePrecisaPano:
  - personagem: "M\xE3e"
    texto: "Preciso apoiar o bra\xE7o dele. Aquele pano de Luzia deve servir."
  paiRepouso:
  - personagem: Pai
    texto: "Eu t\xF4 aqui, Josefa. O bra\xE7o d\xF3i, mas eu t\xF4 aqui."
  - personagem: Pai
    texto: "Fique perto de sua m\xE3e. E num esque\xE7a sua irm\xE3."
  paiDepoisAgua:
  - personagem: Pai
    texto: "Essa pouca \xE1gua j\xE1 ajudou. Obrigado, minha filha."
  - personagem: Pai
    texto: "Guarde a caba\xE7a. N\xF3s ainda vai precisar dela."
  luziaBuscarAgua:
  - personagem: Luzia
    texto: "Seu pai j\xE1 t\xE1 apoiado. Falta uma pouca d'\xE1gua."
  - personagem: Luzia
    texto: "A mulher da distribui\xE7\xE3o ficou com a caba\xE7a de voc\xEAs."
  - personagem: Luzia
    texto: "Vou com tu at\xE9 l\xE1. Depois n\xF3s volta pro abrigo."
  aguaAguardar:
  - personagem: "Funcion\xE1ria"
    texto: "A fila anda devagar. Aqui \xE9 uma por\xE7\xE3o por vez."
  - personagem: "Funcion\xE1ria"
    texto: "Veja primeiro se o homem de voc\xEAs ficou acomodado."
  aguaApresentar:
  - personagem: "Funcion\xE1ria"
    texto: "A caba\xE7a de voc\xEAs j\xE1 foi devolvida."
  - personagem: "Funcion\xE1ria"
    texto: "Ponha ela aqui, que eu separo a por\xE7\xE3o."
  aguaJaRecebida:
  - personagem: "Funcion\xE1ria"
    texto: "A por\xE7\xE3o de voc\xEAs j\xE1 saiu."
  - personagem: "Funcion\xE1ria"
    texto: "\xC9 pouca. Leve pra quem t\xE1 esperando no abrigo."
  maeEsperaAgua:
  - personagem: "M\xE3e"
    texto: "O ombro t\xE1 apoiado, mas a boca dele t\xE1 seca."
  - personagem: "M\xE3e"
    texto: "Aquela mulher deve saber onde t\xE3o distribuindo \xE1gua."
  familiaDepoisAgua:
  - personagem: Luzia
    texto: "A caba\xE7a ficou vazia de novo. Guarde ela."
  - personagem: Luzia
    texto: "N\xF3s continua procurando not\xEDcia de Mariquinha."
  cabacaIndisponivel:
  - personagem: "Funcion\xE1ria"
    texto: "Num achei a caba\xE7a entre esses pertences."
  - personagem: "Funcion\xE1ria"
    texto: "Vou conferir a mesa. N\xE3o precisa largar mais nada."
  pontoParadaFamilia: {fileID: 4100000131}
  seguidoraBaleiaCurrais: {fileID: 953090005}
  familiaDecideParar:
  - personagem: "M\xE3e"
    texto: "Aqui tem sombra. Vamos parar um pouco? Teu bra\xE7o precisa descansar."
  - personagem: Pai
    texto: Vamos. Mas eu ainda quero perguntar pela menina.
  - personagem: "M\xE3e"
    texto: "N\xF3s vai perguntar. Primeiro sente aqui perto de n\xF3s."
  familiaSegueCaminho:
  - personagem: Pai
    texto: Vamos andando mais um pouquinho. Ali adiante parece ter sombra.
  - personagem: "M\xE3e"
    texto: "Eu t\xF4 logo atr\xE1s de tu, Josefa."
  familiaBuscaIrma:
  - personagem: Zefinha
    texto: "E se Mariquinha procurar n\xF3s e num encontrar?"
  - personagem: "M\xE3e"
    texto: "Vamos ficar juntos. Quem souber dela vai encontrar n\xF3s aqui."
  - personagem: Pai
    texto: "Eu tamb\xE9m t\xF4 pensando nisso, minha filha. N\xF3s vai continuar
      procurando."
  proximidadeParada: 3
  cabacaSeparadaMesa:
  - personagem: "Funcion\xE1ria"
    texto: "Separei a caba\xE7a de voc\xEAs. T\xE1 aqui na mesa, pode levar."
  areaDistribuicaoAgua: {fileID: 9931000000}
  pessoasPresentes:
  - personagem: {fileID: 4100000094}
    desenho: {fileID: 4100000096}
    nome: Luzia
    conversa:
    - personagem: Luzia
      texto: "Tem gente chegando desde cedo. Vamos achar um canto pra voc\xEAs."
  - personagem: {fileID: 4300000008}
    desenho: {fileID: 4300000010}
    nome: Raimundo
    conversa:
    - personagem: Raimundo
      texto: Esses baldes num param quietos. Quando eu acabar aqui, escuto melhor.
  - personagem: {fileID: 4300000020}
    desenho: {fileID: 4300000022}
    nome: Lavadeira
    conversa:
    - personagem: Lavadeira
      texto: "T\xF4 separando o que chegou. Cada coisa vai pra um lado."
  - personagem: {fileID: 4200000036}
    desenho: {fileID: 4200000038}
    nome: "Crian\xE7a"
    conversa:
    - personagem: "Crian\xE7a"
      texto: "Fico olhando quem passa. Tem muita gente que eu num conhe\xE7o."
  - personagem: {fileID: 4200000028}
    desenho: {fileID: 4200000030}
    nome: "Escriv\xE3o"
    conversa:
    - personagem: "Escriv\xE3o"
      texto: "T\xF4 conferindo os nomes. Espere eu acabar essa linha."
  - personagem: {fileID: 4300000082}
    desenho: {fileID: 4300000084}
    nome: Bento
    conversa:
    - personagem: Bento
      texto: "Hoje o servi\xE7o come\xE7ou cedo. Ainda num consegui sentar."
  - personagem: {fileID: 4300000086}
    desenho: {fileID: 4300000088}
    nome: Fiscal
    conversa:
    - personagem: Fiscal
      texto: A carga precisa seguir. Num atrapalhe a passagem.
  - personagem: {fileID: 4300000098}
    desenho: {fileID: 4300000100}
    nome: Trabalhador
    conversa:
    - personagem: Trabalhador
      texto: "Vim buscar \xE1gua. Tem mais gente esperando l\xE1."
  - personagem: {fileID: 4400000049}
    desenho: {fileID: 4400000051}
    nome: Trabalhadora
    conversa:
    - personagem: Trabalhadora
      texto: "T\xF4 cuidando de quem ficou aqui dentro."
  - personagem: {fileID: 4400000037}
    desenho: {fileID: 4400000039}
    nome: Mulher
    conversa:
    - personagem: Mulher
      texto: "S\xF3 queria um pouco de sossego."
  - personagem: {fileID: 4400000045}
    desenho: {fileID: 4400000047}
    nome: Homem
    conversa:
    - personagem: Homem
      texto: O dia custa a passar aqui dentro.
  - personagem: {fileID: 4400000065}
    desenho: {fileID: 4400000067}
    nome: Cabo
    conversa:
    - personagem: Cabo
      texto: Essa passagem tem gente esperando. Diga logo.
  - personagem: {fileID: 4500000014}
    desenho: {fileID: 4500000016}
    nome: Lavadeira
    conversa:
    - personagem: Lavadeira
      texto: "Daqui eu vejo o pessoal indo e vindo. \xC9 gente demais pra guardar
        todos os rostos."
  - personagem: {fileID: 4100000086}
    desenho: {fileID: 4100000088}
    nome: Fiscal
    conversa:
    - personagem: Fiscal
      texto: "Primeiro eu confiro os pertences. Depois voc\xEAs seguem."
  - personagem: {fileID: 9807000200}
    desenho: {fileID: 9807000202}
    nome: Guarda
    conversa:
    - personagem: Guarda
      texto: Deixe a passagem livre.
  - personagem: {fileID: 4500000010}
    desenho: {fileID: 4500000012}
    nome: "Escriv\xE3o do posto"
    conversa:
    - personagem: "Escriv\xE3o do posto"
      texto: "Eu preciso terminar de conferir a rela\xE7\xE3o antes de ela seguir."
  examePrimeiroCliqueLuzia: {fileID: 9933000000}
  conversaIntimaPaiAbrigo:
  - personagem: Zefinha
    texto: "T\xE1 doendo muito?"
  - personagem: Pai
    texto: "D\xF3i. Mas agora t\xE1 mais firme."
  - personagem: Zefinha
    texto: Eu fiquei com medo quando ele bateu no senhor.
  - personagem: Pai
    texto: "Eu tamb\xE9m tive medo, minha filha."
  - personagem: Zefinha
    texto: O senhor teve?
  - personagem: Pai
    texto: "Tive. Num queria ver nenhuma de voc\xEAs longe de n\xF3s."
  conversaIntimaMaeAbrigo:
  - personagem: Zefinha
    texto: "E se Mariquinha voltar e num encontrar n\xF3s?"
  - personagem: "M\xE3e"
    texto: "N\xF3s vai deixar algu\xE9m sabendo onde ficou."
  - personagem: Zefinha
    texto: "Ela num sabe o nome de ningu\xE9m aqui."
  - personagem: "M\xE3e"
    texto: "Ent\xE3o n\xF3s come\xE7a dizendo o dela. Pra quem puder escutar."
  noticiaIrmaAbrigo:
  - personagem: Luzia
    texto: Teu pai ficou mais acomodado?
  - personagem: Zefinha
    texto: "Ficou. Mas separaram minha irm\xE3 de n\xF3s na entrada."
  - personagem: Luzia
    texto: Como ela se chama?
  - personagem: Zefinha
    texto: "Maria Severina. N\xF3s chama Mariquinha."
  - personagem: Luzia
    texto: "Vou perguntar na lavagem. Passa muita gente por l\xE1."
  conviteAguaAbrigo:
  - personagem: Luzia
    texto: "Antes de seguir, vamos buscar uma pouca d\u2019\xE1gua. Teu pai precisa
      beber."
  - personagem: Zefinha
    texto: "Ficaram com nossa caba\xE7a."
  - personagem: Luzia
    texto: "Separaram os recipientes na distribui\xE7\xE3o. Venha, eu vou contigo."
  exameDistribuicao: {fileID: 9933000001}
  autorizarCabacaAgua:
  - personagem: Zefinha
    texto: "Aquela caba\xE7a \xE9 nossa. Ficou na revista."
  - personagem: "Funcion\xE1ria"
    texto: Foi deixada aqui com as outras. Pode pegar.
  - personagem: Zefinha
    texto: "Meu pai t\xE1 ferido. N\xF3s veio buscar \xE1gua."
  - personagem: "Funcion\xE1ria"
    texto: "Espere sua vez. Quando eu chamar, traga ela pra c\xE1."
  chamadaDistribuicaoAgua:
  - personagem: "Funcion\xE1ria"
    texto: "Menina da caba\xE7a. Pode chegar."
  apresentacaoPorcaoAgua:
  - personagem: "Funcion\xE1ria"
    texto: "Segure por fora. Num encoste a boca dela no reservat\xF3rio."
  - personagem: Retirante
    texto: Ontem veio com gosto ruim.
  - personagem: "Funcion\xE1ria"
    texto: "Foi a \xE1gua que mandaram. N\xF3s tamb\xE9m bebe dela."
  porcaoRecebidaAgua:
  - personagem: Zefinha
    texto: "S\xF3 isso?"
  - personagem: "Funcion\xE1ria"
    texto: Tem mais gente esperando, minha filha.
  retornoAbrigoAgua:
  - personagem: "M\xE3e"
    texto: Conseguiram?
  - personagem: Zefinha
    texto: Uma pouca.
  - personagem: Pai
    texto: "Molhe s\xF3 minha boca, Zulema."
  necessidadeAguaAbrigo:
  - personagem: "M\xE3e"
    texto: Agora sente um instante, Luzia. A senhora veio se escorando pelo caminho.
  - personagem: Luzia
    texto: "\xC9 s\xF3 uma fraqueza. J\xE1 passa."
  ofertaAguaMae:
  - personagem: Zefinha
    texto: "Beba tamb\xE9m, mainha."
  - personagem: "M\xE3e"
    texto: Deixe pra tu, minha filha.
  - personagem: Zefinha
    texto: "A senhora t\xE1 tremendo."
  ofertaAguaLuzia:
  - personagem: Zefinha
    texto: Tome, dona Luzia.
  - personagem: Luzia
    texto: "E tua m\xE3e?"
  - personagem: "M\xE3e"
    texto: Pode beber. Eu fico aqui com meu marido.
  depoisAguaMae:
  - personagem: "M\xE3e"
    texto: "Obrigada. Agora n\xF3s vai perguntar pela tua irm\xE3."
  - personagem: Luzia
    texto: "Eu fico aqui com ele. Se algu\xE9m trouxer not\xEDcia, digo onde voc\xEAs
      foram."
  depoisAguaLuzia:
  - personagem: Luzia
    texto: "Obrigada, Josefa. Venha. Vamos perguntar pela tua irm\xE3."
  - personagem: "M\xE3e"
    texto: "Eu espero voc\xEAs aqui."
  guardarCabacaAgua:
  - personagem: Pai
    texto: "Guarde a caba\xE7a, minha filha. N\xF3s ainda vai precisar dela."
  esperaChamadaAgua: 2
  alcanceRetornoAgua: 4
  mostrarAjudaTemporaria: 1
  painelAjudaTemporaria: {fileID: 9911880100}
  exameAtendimentoBento: {fileID: 9934000060}
  examePertencesBento: {fileID: 9934000061}
  exameFamiliarBento: {fileID: 9934000063}
  itemEmbrulhoBento: {fileID: 11400000, guid: 9b50d4ab62e94d4aa7e3c132f8c6100e, type: 2}
  areaEmbrulhoBento: {fileID: 9934000062}
  areaFamiliarBento: {fileID: 9934000103}
  familiarBento: {fileID: 9934000101}
  origemFamiliarBento: {fileID: 9934000111}
  chegadaFamiliarBento: {fileID: 9934000121}
  paiRetornoBento: {fileID: 9934000131}
  arteFamiliarBento: {fileID: 9934000102}
  marcadorFamiliarBento: {fileID: 9934000106}
  familiarNoSepultamento: {fileID: 9934000203}
  pausaAtendimentoBento: 2
  tempoCaminhadaBento: 2.5
  bentoReceberPano:
  - personagem: Zefinha
    texto: "Esse ainda t\xE1 limpo."
  - personagem: Trabalhador
    texto: Obrigado. Deixe comigo.
  bentoReceberAgua:
  - personagem: Zefinha
    texto: Trouxe pra ele beber.
  - personagem: Trabalhador
    texto: "Deixe aqui, menina. Primeiro preciso ver como ele t\xE1."
  bentoOuvirMae:
  - personagem: Zefinha
    texto: "Ele t\xE1 ouvindo n\xF3s, mainha?"
  - personagem: "M\xE3e"
    texto: Num sei, minha filha.
  - personagem: Zefinha
    texto: "Eu trouxe a \xE1gua."
  - personagem: "M\xE3e"
    texto: "Deixe com quem t\xE1 ajudando ele."
  bentoOuvirLuzia:
  - personagem: Zefinha
    texto: "Ele t\xE1 ouvindo n\xF3s?"
  - personagem: Luzia
    texto: Num sei, Josefa. Vamos deixar o homem atender.
  - personagem: Zefinha
    texto: "Eu trouxe a \xE1gua."
  - personagem: Luzia
    texto: Deixe junto dele.
  bentoPaiBuscarFamilia:
  - personagem: Zefinha
    texto: "Painho, a fam\xEDlia de Bento sabe que ele caiu?"
  - personagem: Pai
    texto: Vou chamar quem veio com ele.
  - personagem: Zefinha
    texto: "Diga onde n\xF3s t\xE1."
  - personagem: Pai
    texto: Eu digo.
  bentoAtendimentoParou:
  - personagem: Zefinha
    texto: Por que o senhor parou?
  bentoPerguntaMae:
  - personagem: "M\xE3e"
    texto: "Minha filha\u2026"
  - personagem: Zefinha
    texto: Ele num vai levantar?
  bentoPerguntaLuzia:
  - personagem: Luzia
    texto: "Josefa\u2026"
  - personagem: Zefinha
    texto: Ele num vai levantar?
  bentoNoticiaLinear:
  - personagem: Pai
    texto: Bento morreu, Josefa.
  - personagem: Zefinha
    texto: "Mas eu trouxe\u2026"
  - personagem: Pai
    texto: Eu sei, minha filha. Tu tentou ajudar.
  - personagem: Zefinha
    texto: "O servi\xE7o num parou."
  - personagem: Pai
    texto: Mandaram continuar.
  bentoFicar:
  - personagem: Zefinha
    texto: Posso ficar aqui?
  - personagem: ACOMPANHANTE
    texto: Pode. Eu fico contigo.
  bentoPerguntarFamilia:
  - personagem: Zefinha
    texto: Quem veio com ele?
  - personagem: Pai
    texto: "A fam\xEDlia t\xE1 ali, minha filha."
  - personagem: Zefinha
    texto: Eu num sei o que dizer.
  - personagem: Pai
    texto: Num precisa achar palavra agora.
  bentoPertencesPedido:
  - personagem: Trabalhador
    texto: Isso aqui era de Bento.
  - personagem: Zefinha
    texto: Vai ficar com quem?
  - personagem: Trabalhador
    texto: "Com a fam\xEDlia. Pode levar at\xE9 eles?"
  bentoPertencesRecusados:
  - personagem: Zefinha
    texto: Eu prefiro ficar aqui.
  - personagem: Trabalhador
    texto: "T\xE1 certo. Eu levo."
  bentoPertencesEntregues:
  - personagem: Zefinha
    texto: Disseram que era dele.
  - personagem: Familiar
    texto: Era. Obrigada, menina.
  bentoCabacaRecuperada:
  - personagem: Zefinha
    texto: "Nossa caba\xE7a\u2026"
  - personagem: ACOMPANHANTE
    texto: Pode guardar, minha filha.
  bentoLembrarCabaca:
  - personagem: ACOMPANHANTE
    texto: "Josefa, nossa caba\xE7a ficou ali."
  bentoAnuncioSaida:
  - personagem: Pai
    texto: "V\xE3o levar Bento agora."
  bentoEsperar:
  - personagem: Zefinha
    texto: Espere um pouco.
  - personagem: ACOMPANHANTE
    texto: "N\xF3s espera."
  bentoPermissaoSepultamento:
  - personagem: Zefinha
    texto: "Eu quero ir tamb\xE9m."
  - personagem: Pai
    texto: "N\xF3s vai acompanhar a fam\xEDlia."
  - personagem: Fiscal
    texto: "V\xE3o pelo caminho de fora. Depois voltem."
  bentoReunirGrupo:
  - personagem: Pai
    texto: "Vamos juntos, Zulema. Luzia, venha com n\xF3s."
  - personagem: "M\xE3e"
    texto: Eu vou, minha filha.
  - personagem: Luzia
    texto: "Eu tamb\xE9m vou."
  bentoSepultamentoInicio:
  - personagem: ACOMPANHANTE
    texto: Fique aqui comigo, Josefa.
  bentoNomeSepultamento:
  - personagem: Pai
    texto: "Bento. N\xF3s num esquece teu nome."
  bentoSepultamentoFamilia:
  - personagem: Zefinha
    texto: "Nem todo mundo p\xF4de vir?"
  - personagem: Pai
    texto: "Alguns ficaram no servi\xE7o."
  bentoRetornoCruzes:
  - personagem: Zefinha
    texto: "Essas cruzes\u2026 tamb\xE9m s\xE3o de quem tava aqui?"
  - personagem: "M\xE3e"
    texto: "S\xE3o, minha filha."
  - personagem: Zefinha
    texto: Tem umas sem nome.
  - personagem: Luzia
    texto: "\xC0s vezes a fam\xEDlia nem chega a saber onde ficou."
  - personagem: "M\xE3e"
    texto: "Disseram que aqui n\xF3s ia encontrar socorro."
  - personagem: Zefinha
    texto: "E Mariquinha t\xE1 em algum lugar desses?"
  - personagem: "M\xE3e"
    texto: "N\xF3s ainda t\xE1 procurando tua irm\xE3."
  - personagem: Pai
    texto: Vamos voltar juntos.
  setorBusca: {fileID: 4300000000}
  areaRaimundo: {fileID: 4300000011}
  areaLavadeira: {fileID: 4300000023}
  areaPanoLavagem: {fileID: 4300000027}
