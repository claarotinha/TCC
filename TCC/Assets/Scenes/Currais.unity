  areaMesaDocumento: {fileID: 4400000011}
  areaTrabalhadoraQuarto: {fileID: 4400000052}
  areaCaboQuarto: {fileID: 4400000068}
  areaDoenteUm: {fileID: 4400000040}
  areaDoenteDois: {fileID: 4400000048}
  postoSeguinte:
  - personagem: Luzia
    texto: O quarto de atendimento fica perto do tanque grande.
  - personagem: Luzia
    texto: "Se algu\xE9m viu o outro grupo, pode t\xE1 l\xE1."
  registroRevisado:
  - personagem: Zefinha
    texto: Lagoa do Meio. Eu guardei esse lugar no caderno.
  - personagem: Zefinha
    texto: "O papel num diz se Mariquinha chegou l\xE1."
  folhaRetirada:
  - personagem: Zefinha
    texto: "J\xE1 levaram a folha."
  - personagem: Raimundo
    texto: Eu ainda vou perguntar pelo grupo da menina.
  quartoRevisita:
  - personagem: Trabalhadora
    texto: "Aqui s\xF3 est\xE3o as pessoas que tu j\xE1 viu."
  - personagem: Trabalhadora
    texto: Se eu ouvir Maria Severina, procuro dona Luzia.
  quartoVoltarFamilia:
  - personagem: Luzia
    texto: "Sua m\xE3e ficou com Baleia, perto das esteiras."
  - personagem: Luzia
    texto: "Vamos contar o que n\xF3s viu, Josefa."
  quartoSemCabaca:
  - personagem: Trabalhadora
    texto: "Preciso de um recipiente vazio para buscar \xE1gua."
  - personagem: Trabalhadora
    texto: Se tu puder emprestar, eu devolvo.
  caboQuartoFalas:
  - personagem: Cabo
    texto: "J\xE1 viu quem t\xE1 aqui. Deixe o atendimento seguir."
  doenteUmFalas:
  - personagem: Pessoa em repouso
    texto: "Disseram que eu ia descansar um pouco\u2026"
  - personagem: Trabalhadora
    texto: "Fique aqui. N\xF3s t\xE1 perto."
  doenteDoisFalas:
  - personagem: Outra pessoa em repouso
    texto: "\xC1gua\u2026 por favor."
  - personagem: Trabalhadora
    texto: "Eu j\xE1 trago. Espere um pouco."
  maeAmparoEntrada: {fileID: 9933000111}
  chegadaFamilia:
  - personagem: Mulher da fila
    texto: "Fique comigo. A fila t\xE1 andando."
  - personagem: "Crian\xE7a da fila"
    texto: "Mainha, \xE9 pra entrar aqui?"
  - personagem: Mulher da fila
    texto: "\xC9. Num se afaste de mim."
  - personagem: Mariquinha
    texto: Fica pertinho de mim, Zefinha.
  - personagem: Zefinha
    texto: "T\xF4 aqui."
  areaGuardaRonda: {fileID: 9807000203}
  panoEmLavagem: {fileID: 9977000012}
  panoMergulhoLavagem: {fileID: 9977000021}
  luziaRetornoLembranca: {fileID: 9977000041}
  inicioLembranca: {fileID: 9977000051}
  varalPanosUso: {fileID: 9977000030}
  lavadeiraEsperaLote:
  - personagem: Lavadeira
    texto: "O lote da mesa dos nomes vem pra c\xE1."
  - personagem: Lavadeira
    texto: Com esses panos aqui, eu consigo abrir lugar no tanque.
  lavadeiraIrma:
  - personagem: Lavadeira
    texto: "Eu vi uma menina perguntando pela m\xE3e."
  - personagem: Lavadeira
    texto: Tava com uma mulher. Num sei pra onde seguiram.
  raimundoRetorno:
  - personagem: Raimundo
    texto: "Ainda t\xF4 perguntando por aquela mulher."
  - personagem: Raimundo
    texto: "S\xF3 vou dar um nome quando tiver certeza."
  lavagemFaltaUso:
  - personagem: Lavadeira
    texto: Os panos que voltam ao uso ficam deste lado.
  - personagem: Lavadeira
    texto: "N\xE3o misture com as pe\xE7as do atendimento."
  lavagemFaltaAtendimento:
  - personagem: Lavadeira
    texto: "As pe\xE7as do atendimento ficam do outro lado."
  - personagem: Lavadeira
    texto: "Mesmo depois da \xE1gua, elas continuam separadas."
  lavagemConcluida:
  - personagem: Lavadeira
    texto: Agora cada coisa ficou no seu lugar.
  - personagem: Lavadeira
    texto: Separei um retalho limpo ali pra tu.
  lavagemUsoRecebido:
  - personagem: Zefinha
    texto: Estes ficam aqui?
  - personagem: Lavadeira
    texto: Isso. Os do atendimento ficam separados, do outro lado.
  lavagemAtendimentoRecebido:
  - personagem: Zefinha
    texto: Vou deixar estes longe dos outros.
  - personagem: Lavadeira
    texto: "Certo. Falta s\xF3 o lote de uso."
  luziaAntesRaimundo:
  - personagem: Luzia
    texto: Aquele homem tava perto dos baldes quando o carro passou.
  - personagem: Luzia
    texto: Talvez tenha visto o outro grupo.
  luziaAntesLavagem:
  - personagem: Luzia
    texto: A mulher da lavagem espera o lote que tu trouxe.
  - personagem: Luzia
    texto: Raimundo vai perguntar pela mulher que viu.
  luziaNaPassagem:
  - personagem: Luzia
    texto: "Guarde o retalho. Esse caminho leva pro p\xE1tio."
  - personagem: Luzia
    texto: Eu vou junto de tu.
  luziaDepoisPassagem:
  - personagem: Luzia
    texto: "Eu t\xF4 aqui, Josefa."
  - personagem: Luzia
    texto: "Seu pai t\xE1 no carregamento, depois dessa passagem."
  guardaPassagemFalas:
  - personagem: Guarda
    texto: "Essa passagem d\xE1 no servi\xE7o. Nada de mexer nos sacos."
  - personagem: Luzia
    texto: "N\xF3s s\xF3 t\xE1 passando."
  lembrancaSemLenda:
  - personagem: Luzia
    texto: "Josefa. Olhe pra mim. N\xF3s ainda t\xE1 aqui."
  - personagem: Zefinha
    texto: Por um instante eu perdi o caminho.
  - personagem: Luzia
    texto: Vem. Eu fico perto de tu.
  aberturaEncerramento:
  - personagem: "M\xE3e"
    texto: Sente aqui, Josefa. Tu num precisa guardar tudo sozinha.
  - personagem: Zefinha
    texto: "Eu num quero esquecer ningu\xE9m."
  bentoEncerramento:
  - personagem: Zefinha
    texto: Eu num quero esquecer o nome dele. Bento.
  - personagem: Pai
    texto: "Ent\xE3o n\xF3s guarda tamb\xE9m."
  - personagem: "M\xE3e"
    texto: "Tem muita fam\xEDlia que veio buscar socorro e perdeu algu\xE9m aqui."
  fimFamiliaEncerramento:
  - personagem: "M\xE3e"
    texto: "N\xF3s vai continuar perguntando por Severina."
  - personagem: Zefinha
    texto: E pelas outras pessoas?
  - personagem: "M\xE3e"
    texto: "Tem muita fam\xEDlia perguntando, minha filha."
  - personagem: Zefinha
    texto: "Maria Severina. Mariquinha. Minha irm\xE3."
  imagensPassagem:
  - {fileID: 9810000000}
  - {fileID: 9810000100}
  - {fileID: 9810000200}
  familiaPromessas:
  - personagem: Zefinha
    texto: "Por que trouxeram n\xF3s pra c\xE1?"
  - personagem: Pai
    texto: "Disseram que tinha comida e servi\xE7o. N\xF3s precisava dos dois."
  - personagem: "M\xE3e"
    texto: "S\xF3 num disseram que iam decidir at\xE9 quando n\xF3s podia sair."
  - personagem: Zefinha
    texto: "A rua t\xE1 logo ali."
  - personagem: "M\xE3e"
    texto: "E tem um homem mandando n\xF3s ficar deste lado. Num foi isso que prometeram."
  familiaTrabalho:
  - personagem: Zefinha
    texto: "O senhor vai trabalhar amanh\xE3?"
  - personagem: Pai
    texto: "V\xE3o chamar."
  - personagem: Zefinha
    texto: "Mesmo com o bra\xE7o assim?"
  - personagem: Pai
    texto: Vou falar de novo. Hoje falar num adiantou.
  - personagem: "M\xE3e"
    texto: "Tu precisa de descanso, num \xE9 de mais carga."
  - personagem: Zefinha
    texto: "E a fam\xEDlia de Bento?"
  - personagem: Pai
    texto: Ficaram os que estavam com ele. Agora precisam atravessar mais esse dia.
  familiaCaderno:
  - personagem: Zefinha
    texto: "Eu queria lembrar das coisas de casa. Agora s\xF3 penso no que vi hoje."
  - personagem: "M\xE3e"
    texto: Pode me contar. Num precisa guardar tudo sozinha.
  - personagem: Zefinha
    texto: Vou guardar este caderno.
  - personagem: "M\xE3e"
    texto: Guarde. E quando quiser falar, eu escuto.
  noiteCaderno:
  - personagem: Zefinha
    texto: "O caderno t\xE1 aqui, mainha."
  - personagem: "M\xE3e"
    texto: Pode deixar junto de tu.
  - personagem: Zefinha
    texto: Eu num quero esquecer dos nomes.
  - personagem: "M\xE3e"
    texto: "N\xF3s vai lembrar junto."
  diarioNaNoite: {fileID: 9809000100}
  personagensNoAbrigo:
  - {fileID: 1304905424}
  - {fileID: 467838415}
  - {fileID: 1156249497}
  - {fileID: 4100000096}
  posesDeRepouso:
  - {fileID: 9992000002}
  - {fileID: 9992000012}
  - {fileID: 9992000022}
  - {fileID: 9992000032}
  amanhecerFamilia:
  - personagem: "M\xE3e"
    texto: "J\xE1 t\xE3o chamando l\xE1 fora. Tu conseguiu descansar um pouquinho?"
  - personagem: Zefinha
    texto: Eu pensei que ia ouvir Mariquinha acordando do meu lado.
  - personagem: "M\xE3e"
    texto: "Eu tamb\xE9m. O lugar dela continua aqui."
  - personagem: Pai
    texto: "Raimundo ficou de perguntar pela mulher. Antes de chamarem ele pro servi\xE7o,
      ainda d\xE1 pra conversar."
  baldeAindaSemPano:
  - personagem: Raimundo
    texto: "Ainda falta enrolar o pano na al\xE7a. Pode ficar com ele enquanto ajeita."
  baldeRaimundoItem: {fileID: 11400000, guid: b11e09ebfa2649e9bcdebf9897576196, type: 2}
  baldeProtegidoItem: {fileID: 11400000, guid: ecc5ce58a0624777a7649e4462b72229, type: 2}
  combinacaoBalde: {fileID: 11400000, guid: 319b55230cb740d0bf923ad305ab076a, type: 2}
  areaBaldeRaimundo: {fileID: 9809000003}
  baldeRaimundoCenario: {fileID: 9809000000}
  pedidoBaldeFalas:
  - personagem: Zefinha
    texto: "Posso proteger a al\xE7a? A lavadeira me deixou uma tira limpa."
  - personagem: Raimundo
    texto: "Pode. Pegue o balde aqui do lado, vazio. Enrole o pano na parte que pega
      na m\xE3o."
  baldeDevolvidoFalas:
  - personagem: Raimundo
    texto: Assim num corta tanto. Obrigado, Josefa.
  - personagem: Zefinha
    texto: Agora o senhor consegue deixar um pouco esse peso?
  - personagem: Raimundo
    texto: "Consigo apoiar aqui enquanto n\xF3s conversa."
  nomeRaimundoFalas:
  - personagem: Raimundo
    texto: "Falei com outra lavadeira. Nair Pereira. Ela confirmou que era a mulher
      junto de tua irm\xE3."
  - personagem: Zefinha
    texto: A senhora que tava com Mariquinha?
  - personagem: Raimundo
    texto: "Foi quem eu vi com ela. Tua irm\xE3 tava viva, andando. Pra onde chegaram,
      isso eu num vi."
  - personagem: Zefinha
    texto: Nair Pereira. Vou contar a mainha e painho.
  papelApresentado:
  - personagem: Zefinha
    texto: "Eu trouxe o canhoto. Essa marca \xE9 a do carro que levou o grupo."
  - personagem: "Escriv\xE3o"
    texto: "Pode deixar comigo um instante pra conferir. O que o papel diz \xE9 encaminhamento;
      num prova que chegaram."
  - personagem: Pai
    texto: "N\xF3s entende. Queremos saber o que d\xE1 pra confirmar."
  areaPanosUso: {fileID: 9807000003}
  areaPanosAtendimento: {fileID: 9807000103}
  panoUsoLavagem: {fileID: 11400000, guid: b278216d191540f89d39cc53a3435d28, type: 2}
  panoAtendimentoLavagem: {fileID: 11400000, guid: f2ffd4b6176a40c0aedc2cb344a82b7c, type: 2}
  tiraPanoLavagem: {fileID: 11400000, guid: 8f49235c833546788d54299480a46a9b, type: 2}
  panoUsoEntregue: {fileID: 9807000030}
  panoAtendimentoEntregue: {fileID: 9807000130}
  instrucoesLavagem:
  - personagem: Zefinha
    texto: "Essas aqui t\xEAm sangue\u2026"
  - personagem: Lavadeira
    texto: Vieram do atendimento. Ficam daquele lado.
  - personagem: Zefinha
    texto: E estas?
  - personagem: Lavadeira
    texto: "S\xE3o de uso. Deixe \xE0 esquerda, longe das outras."
  - personagem: Zefinha
    texto: Num pode lavar tudo junto?
  - personagem: Lavadeira
    texto: "Num pode. Com o pouco que n\xF3s tem, ainda precisa cuidar disso."
  tiraPanoAutorizada:
  - personagem: Lavadeira
    texto: "Pode levar esse retalho limpo. Raimundo tava precisando proteger a al\xE7a
      do balde."
  guardaRepreensao:
  - personagem: Guarda
    texto: "Essa passagem d\xE1 no servi\xE7o. Nada de mexer nos sacos."
  - personagem: Luzia
    texto: "N\xF3s s\xF3 t\xE1 passando."
  raimundoTrabalho:
  - personagem: Zefinha
    texto: "Essa m\xE3o t\xE1 machucada?"
  - personagem: Raimundo
    texto: "A al\xE7a abriu de novo."
  - personagem: Zefinha
    texto: Num pode parar?
  - personagem: Raimundo
    texto: "Posso largar o balde. Depois v\xEAm perguntar por que larguei."
  - personagem: Zefinha
    texto: Disseram que aqui tinha trabalho.
  - personagem: Raimundo
    texto: "Disseram se n\xF3s podia escolher?"
  - personagem: Zefinha
    texto: "Painho mal consegue levantar o bra\xE7o."
  - personagem: Raimundo
    texto: Eu vi ele. Se mandarem pro carregamento, fico por perto.
  - personagem: Zefinha
    texto: Num deixa ele sozinho.
  - personagem: Raimundo
    texto: Vou fazer o que puder.
  guardaRonda: {fileID: 9807000201}
  rondaInicio: {fileID: 9807000301}
  rondaFim: {fileID: 9807000311}
  retornoRonda: {fileID: 9807000321}
  fimPassagem: {fileID: 9807000331}
  abrigoDosSacos: {fileID: 9807000403}
  velocidadeRonda: 2.2
  alcanceVigia: 3.5
  exameLavadeiraLinear: {fileID: 9933000030}
  examePilhaUso: {fileID: 9933000031}
  examePilhaAtendimento: {fileID: 9933000032}
  areaRecebimentoLavagem: {fileID: 9933000033}
  chegadaLavagemMae:
  - personagem: "M\xE3e"
    texto: "Deve ser aqui. Ela t\xE1 separando os lotes."
  - personagem: Zefinha
    texto: Eu pergunto, mainha.
  - personagem: "M\xE3e"
    texto: Eu fico contigo.
  chegadaLavagemLuzia:
  - personagem: Luzia
    texto: "\xC9 aqui que ficam os panos."
  - personagem: Zefinha
    texto: "Ser\xE1 que foi ela quem viu a menina?"
  - personagem: Luzia
    texto: Vamos perguntar.
  loteLavagemOrientacao:
  - personagem: Zefinha
    texto: O homem da mesa mandou trazer uns panos.
  - personagem: Lavadeira
    texto: Pode deixar aqui, junto do tanque.
  loteLavagemInicio:
  - personagem: Lavadeira
    texto: Foi ele quem mandou tu trazer?
  - personagem: Zefinha
    texto: "Disse que procurava minha irm\xE3 quando eu voltasse."
  - personagem: Lavadeira
    texto: Sempre arranja mais uma coisa antes.
  loteLavagemMae:
  - personagem: "M\xE3e"
    texto: "Separaram minha menina na entrada. N\xF3s num sabe onde procurar."
  loteLavagemLuzia:
  - personagem: Luzia
    texto: Raimundo viu uma menina parecida com ela. Tava com uma mulher.
  loteLavagemPista:
  - personagem: Lavadeira
    texto: "Passou uma aqui perguntando pelo carro de tr\xE1s."
  - personagem: Zefinha
    texto: O que ela perguntou?
  - personagem: Lavadeira
    texto: "Se a m\xE3e vinha nele."
  - personagem: Zefinha
    texto: "Mariquinha pode ter pensado que n\xF3s vinha atr\xE1s\u2026"
  - personagem: Lavadeira
    texto: "Me ajude com estas enquanto n\xF3s conversa."
  conversaLavagemIrma:
  - personagem: Zefinha
    texto: "A menina que passou aqui\u2026 tava chorando?"
  - personagem: Lavadeira
    texto: "Tava procurando a m\xE3e no meio de quem chegava."
  - personagem: Zefinha
    texto: E a mulher que tava com ela?
  - personagem: Lavadeira
    texto: "Segurava a m\xE3o dela. Num ouvi o nome."
  - personagem: Zefinha
    texto: Raimundo acha que conhece essa mulher.
  - personagem: Lavadeira
    texto: "Ent\xE3o deixe ele perguntar. Eu num sei te dizer quem era."
  correcaoPilhaLavagem:
  - personagem: Lavadeira
    texto: "Esses s\xE3o da outra pilha, minha filha."
  conclusaoLavagem:
  - personagem: Lavadeira
    texto: Pronto. Agora posso cuidar de cada lote.
  - personagem: Zefinha
    texto: A senhora faz isso todo dia?
  - personagem: Lavadeira
    texto: Todo dia chega mais.
  retalhoPedidoZefinha:
  - personagem: Zefinha
    texto: "Tem um pedacinho limpo que sobre? A al\xE7a abriu a m\xE3o de Raimundo."
  - personagem: Lavadeira
    texto: Separei este. Pode levar pra ele.
  retalhoOferecidoLavadeira:
  - personagem: Lavadeira
    texto: "Leve este retalho pra Raimundo. A al\xE7a do balde t\xE1 ferindo a m\xE3o
      dele."
  - personagem: Zefinha
    texto: Ele continua carregando assim?
  - personagem: Lavadeira
    texto: Continua. Talvez isso ajude um pouco.
  saidaLavagemMae:
  - personagem: Zefinha
    texto: Vou guardar pra dar a Raimundo.
  - personagem: "M\xE3e"
    texto: Guarde num canto limpo. Vamos juntas.
  saidaLavagemLuzia:
  - personagem: Zefinha
    texto: Vou guardar pra dar a Raimundo.
  - personagem: Luzia
    texto: "Venha. A passagem pro p\xE1tio \xE9 por aqui."
  alcanceChegadaLavagem: 5
  exameRaimundoManha: {fileID: 9911880021}
  planoMemoria: {fileID: 4600000000}
  folhaMemoria: {fileID: 4600000006}
  lacoMemoria: {fileID: 4600000010}
  documentoMemoria: {fileID: 4600000018}
  maoMemoria: {fileID: 4600000022}
  quartoMemoria: {fileID: 4600000028}
  areaPaginasMemoria: {fileID: 4400000105}
  mariPlanoMemoria: {fileID: 4600000031}
  cameraPlanoMemoria: {fileID: 4600000033}
  paginasMemoria:
  - personagem: "Mem\xF3ria de Zefinha"
    texto: "Perguntamos aos que chegavam. Ningu\xE9m trouxe not\xEDcia de Severina."
  - personagem: "Mem\xF3ria de Zefinha"
    texto: "Sa\xEDmos de l\xE1. Painho guardava as perguntas. Mainha guardava os
      nomes."
  - personagem: "Mem\xF3ria de Zefinha"
    texto: "Toda menina vista de longe fazia eu olhar outra vez. O tempo passou,
      mas n\xF3s continuou procurando."
  pensamentoMemoria:
    personagem: Mari (pensamento)
    texto: A bisa viveu tudo isso. E continuou procurando. Eu preciso lembrar das
      pessoas, dos nomes e do que fizeram com elas.
  chamadoPresente:
    personagem: "M\xE3e de Mari (presente)"
    texto: Maria Gabriely...
  idsPaginasMemoria:
  - currais-dias-depois
  - currais-meses-depois
  - currais-mais-tarde
  objetivoPaginasMemoria: 
  duracaoPaginaMemoria: 6
  leituraMinimaMemoria: 1.5
  duracaoCorteMemoria: 1.5
  cenaEpilogo: epilogo
  exameMeninoNomes: {fileID: 9933000010}
  exameLataNomes: {fileID: 9933000011}
  exameFolhasNomes: {fileID: 9933000012}
  exameCanhotoNomes: {fileID: 9933000013}
  pedidoNomeInicio:
  - personagem: Zefinha
    texto: "Maria Severina. Minha irm\xE3. Levaram ela com outro grupo antes de n\xF3s
      entrar."
  - personagem: "Escriv\xE3o"
    texto: Sabe em qual carro?
  - personagem: Zefinha
    texto: Num sei. Eu vi ela indo embora.
  pedidoNomeMae:
  - personagem: "M\xE3e"
    texto: "N\xF3s chegou junto. Separaram minha menina de n\xF3s."
  pedidoNomeLuzia:
  - personagem: Luzia
    texto: "A fam\xEDlia acabou de chegar. A menina ficou no outro grupo."
  pedidoNomeServico:
  - personagem: "Escriv\xE3o"
    texto: Tenho os nomes dos grupos nestas folhas. Preciso terminar de conferir.
  - personagem: Zefinha
    texto: O senhor pode procurar o dela?
  - personagem: "Escriv\xE3o"
    texto: Leve aquele lote de panos pra lavagem. Quando voltar, pergunte.
  pedidoNomeProtestoMae:
  - personagem: "M\xE3e"
    texto: "Minha filha veio atr\xE1s da irm\xE3."
  pedidoNomeProtestoLuzia:
  - personagem: Luzia
    texto: Ao menos anote o nome dela.
  pedidoNomeFinal:
  - personagem: "Escriv\xE3o"
    texto: Eu ouvi. Maria Severina. Agora leve os panos.
  reencontroComDestino:
  - personagem: Zefinha
    texto: "Disseram que o carro foi pra Lagoa do Meio. Ainda preciso saber se ela
      chegou l\xE1."
  - personagem: "Crian\xE7a"
    texto: "Meu tio tamb\xE9m vinha de longe. Mainha disse que viagem demora."
  reencontroSemDestino:
  - personagem: Zefinha
    texto: Fui perguntar na mesa. Mandaram eu levar os panos primeiro.
  - personagem: "Crian\xE7a"
    texto: "E agora v\xE3o procurar?"
  - personagem: Zefinha
    texto: Vou perguntar de novo.
  canhotoIntervencao:
  - personagem: Fiscal
    texto: "Os pap\xE9is ficam. J\xE1 pegou os panos?"
  canhotoDestino:
  - personagem: Zefinha
    texto: "Essa marca \xE9 do carro que levou o outro grupo?"
  - personagem: Fiscal
    texto: "\xC9 do encaminhamento."
  - personagem: Zefinha
    texto: Pra onde levaram eles?
  - personagem: Fiscal
    texto: "Lagoa do Meio. Est\xE1 escrito a\xED."
  - personagem: Zefinha
    texto: "Minha irm\xE3 foi junto."
  - personagem: Fiscal
    texto: "Ent\xE3o leve o canhoto e pergunte l\xE1. Agora siga."
  canhotoGuardadoMae:
  - personagem: Zefinha
    texto: "Lagoa do Meio\u2026"
  - personagem: "M\xE3e"
    texto: "Guarde esse papel, minha filha. N\xF3s vai perguntar por ela."
  canhotoGuardadoLuzia:
  - personagem: Zefinha
    texto: "Lagoa do Meio\u2026"
  - personagem: Luzia
    texto: "Guarde. Esse papel pode ajudar quando n\xF3s perguntar."
  exameGuardaPassagem: {fileID: 9933000040}
  guardaPassagemPergunta:
  - personagem: Zefinha
    texto: "\xC9 por aqui que chega no carregamento?"
  - personagem: Guarda
    texto: "\xC9. Nada de mexer nos sacos."
  guardaPassagemMae:
  - personagem: "M\xE3e"
    texto: "N\xF3s vai encontrar meu marido."
  guardaPassagemLuzia:
  - personagem: Luzia
    texto: "N\xF3s s\xF3 t\xE1 passando."
  chamadaPassagemMae:
  - personagem: "M\xE3e"
    texto: "Josefa. Olhe pra mainha. Eu t\xF4 aqui contigo."
  chamadaPassagemLuzia:
  - personagem: Luzia
    texto: "Josefa. Olhe pra mim. N\xF3s ainda t\xE1 aqui."
  reacaoCorpoPassagem:
  - personagem: Zefinha
    texto: "Tinha algu\xE9m ali na cerca."
  - personagem: ACOMPANHANTE
    texto: "Olhe de novo, Josefa. \xC9 a sombra do galho."
  reacaoComadrePassagem:
  - personagem: Zefinha
    texto: Eu escutei ela.
  - personagem: ACOMPANHANTE
    texto: "Eu escutei o guarda assobiar. Vem pelo lado de c\xE1."
  reacaoAguaPassagem:
  - personagem: Zefinha
    texto: Eu vi Mariquinha.
  - personagem: ACOMPANHANTE
    texto: Onde, minha filha?
  - personagem: Zefinha
    texto: "Ali\u2026 agora num t\xE1 mais."
  reacaoSemLendaPassagem:
  - personagem: Zefinha
    texto: Por um instante eu perdi o caminho.
  - personagem: ACOMPANHANTE
    texto: Vem. Eu fico perto de tu.
  continuarPassagemMae:
  - personagem: "M\xE3e"
    texto: Vamos encontrar teu pai.
  - personagem: Zefinha
    texto: Fique perto de mim, mainha.
  - personagem: "M\xE3e"
    texto: Eu fico.
  continuarPassagemLuzia:
  - personagem: Luzia
    texto: "Teu pai t\xE1 no carregamento, logo adiante."
  - personagem: Zefinha
    texto: Vamos.
  areaPaiPatio: {fileID: 9988000002}
  areaBentoPatio: {fileID: 4300000085}
  areaFiscalPatio: {fileID: 4300000089}
  poseBentoSocorro: {fileID: 9988000012}
  panoNoSocorro: {fileID: 9988000022}
  pertencesBentoCobertos: {fileID: 9988000032}
  cabacaPatioComMari: {fileID: 9988000042}
  bentoTrabalhoFalas:
  - personagem: Trabalhador
    texto: "A carga num acaba. Eu s\xF3 preciso de um pouco de ar."
  - personagem: Trabalhador
    texto: Desde cedo num deixam a gente parar.
  fiscalPatioFalas:
  - personagem: Fiscal
    texto: Tem carro esperando. Cada um cuida da sua carga.
  - personagem: Zefinha
    texto: "Meu pai t\xE1 machucado."
  patioVoltarPai:
  - personagem: Luzia
    texto: "O apoio t\xE1 pronto. Seu pai ficou perto da carro\xE7a."
  - personagem: Luzia
    texto: Vamos voltar pra perto dele.
  luziaInicioPatio:
  - personagem: Luzia
    texto: "Seu pai ficou perto da carro\xE7a."
  - personagem: Luzia
    texto: Vamos ouvir o que ele precisa.
  luziaTarefasPatio:
  - personagem: Luzia
    texto: "O pano vai pro apoio, do outro lado do p\xE1tio."
  - personagem: Luzia
    texto: "A por\xE7\xE3o de \xE1gua fica perto da passagem."
  luziaAguaPatio:
  - personagem: Luzia
    texto: "O pano j\xE1 ficou no apoio."
  - personagem: Luzia
    texto: "Falta buscar a por\xE7\xE3o de \xE1gua na caba\xE7a."
  luziaPanoPatio:
  - personagem: Luzia
    texto: "A \xE1gua j\xE1 t\xE1 contigo."
  - personagem: Luzia
    texto: "O pano ainda precisa ficar no apoio do p\xE1tio."
  patioFaltaAgua:
  - personagem: Trabalhador
    texto: "A por\xE7\xE3o do servi\xE7o fica neste ponto."
  - personagem: Trabalhador
    texto: "Com a caba\xE7a vazia, eu separo \xE1gua pro atendimento."
  patioFaltaPano:
  - personagem: Trabalhador
    texto: "O apoio do p\xE1tio ainda t\xE1 sem pano limpo."
  - personagem: Trabalhador
    texto: Deixe aqui o que trouxeram. Pode fazer falta.
  socorroFaltaAgua:
  - personagem: Luzia
    texto: "O pano j\xE1 t\xE1 com n\xF3s. Falta a \xE1gua da caba\xE7a."
  - personagem: Luzia
    texto: "A por\xE7\xE3o que tu buscou \xE9 pro atendimento."
  socorroFaltaPano:
  - personagem: Luzia
    texto: "A \xE1gua j\xE1 t\xE1 aqui. Falta um pano limpo."
  - personagem: Luzia
    texto: Tem outros no apoio, perto da passagem.
  socorroFaltamAmbos:
  - personagem: Luzia
    texto: "N\xF3s precisa do pano limpo e da \xE1gua."
  - personagem: Luzia
    texto: Traga o que tu conseguiu, Josefa.
  pertencesSemPano:
  - personagem: Trabalhador
    texto: Os pertences de Bento precisam de um pano limpo.
  - personagem: Pai
    texto: "N\xF3s vai acompanhar ele. A caba\xE7a tamb\xE9m \xE9 de voc\xEAs."
  despedidaPronta:
  - personagem: Pai
    texto: "Os pertences t\xE3o guardados. Podemos acompanhar Bento."
  - personagem: Luzia
    texto: Eu vou junto de tu, Josefa.
  cabacaGuardada:
  - personagem: Zefinha
    texto: "Vou guardar a caba\xE7a da fam\xEDlia."
  - personagem: Luzia
    texto: "Guarde. N\xF3s ainda vai precisar dela."
  socorroGuardarCabaca:
  - personagem: Luzia
    texto: "Os pertences j\xE1 t\xE3o guardados."
  - personagem: Luzia
    texto: "A caba\xE7a de voc\xEAs ainda t\xE1 junto do atendimento."
  examePaiTrabalho: {fileID: 9933000050}
  exameBentoTrabalho: {fileID: 9933000051}
  exameFiscalTrabalho: {fileID: 9933000052}
  exameApoioTrabalho: {fileID: 9933000053}
  areaPanoLimpoApoio: {fileID: 9933000054}
  alcanceLevarAguaPatio: 5
  alcanceChegadaPatio: 7
  patioChegadaMae:
  - personagem: Zefinha
    texto: Botaram painho pra carregar?
  - personagem: "M\xE3e"
    texto: Eu vou falar com ele.
  patioChegadaLuzia:
  - personagem: Zefinha
    texto: "\xC9 painho ali na carro\xE7a?"
  - personagem: Luzia
    texto: "\xC9. Vamos chegar perto."
  patioPaiAbertura:
  - personagem: Zefinha
    texto: "Painho, o senhor num devia t\xE1 levantando isso."
  - personagem: Pai
    texto: "Eu t\xF4 usando o outro bra\xE7o."
  - personagem: Zefinha
    texto: "Mas t\xE1 doendo. Eu t\xF4 vendo."
  patioProtestoMae:
  - personagem: "M\xE3e"
    texto: Ele foi ferido na entrada. Precisa descansar.
  patioProtestoLuzia:
  - personagem: Luzia
    texto: "Ele j\xE1 avisou que num consegue carregar."
  patioFiscalReplica:
  - personagem: Fiscal
    texto: Tem carga esperando.
  patioApresentarBento:
  - personagem: Zefinha
    texto: E se ele num conseguir?
  - personagem: Pai
    texto: Josefa, fique perto. Num entre no meio dos carros.
  - personagem: Zefinha
    texto: "Aquele homem tamb\xE9m t\xE1 passando mal."
  - personagem: Pai
    texto: "\xC9 Bento. T\xE1 assim desde cedo."
  patioPaiEntregaPano:
  - personagem: Pai
    texto: "Veja naquele apoio se tem alguma coisa pra n\xF3s beber."
  - personagem: Pai
    texto: "Leve esse pano tamb\xE9m. Pergunte se serve l\xE1."
  - personagem: Zefinha
    texto: O senhor num vai precisar?
  - personagem: Pai
    texto: "Aqui na minha m\xE3o ele num ajuda ningu\xE9m."
  patioBentoAjuda:
  - personagem: Zefinha
    texto: O senhor precisa de ajuda?
  - personagem: Bento
    texto: "S\xF3 queria tomar um ar."
  - personagem: Zefinha
    texto: Num pode sentar um pouco?
  - personagem: Bento
    texto: Quando eu paro, a carga fica.
  - personagem: Zefinha
    texto: "Eu posso chamar algu\xE9m."
  - personagem: Bento
    texto: "Veja se tem \xE1gua, menina."
  patioFiscalPedido:
  - personagem: Zefinha
    texto: Deixe painho parar um pouco.
  - personagem: Fiscal
    texto: "V\xE1 ficar com sua fam\xEDlia."
  - personagem: Zefinha
    texto: "Eu t\xF4 falando dele."
  - personagem: Fiscal
    texto: Eu ouvi.
  patioApoioPedido:
  - personagem: Zefinha
    texto: "Tem \xE1gua pros homens da carro\xE7a?"
  - personagem: Trabalhador
    texto: "Tem uma por\xE7\xE3o separada. Tu tem recipiente?"
  - personagem: Zefinha
    texto: "Tenho nossa caba\xE7a."
  - personagem: Trabalhador
    texto: Traga aqui.
  - personagem: Trabalhador
    texto: "E esse pano limpo? Pode deixar no apoio? N\xF3s t\xE1 sem nenhum."
  - personagem: Zefinha
    texto: "Se algu\xE9m precisar, vai ter aqui?"
  - personagem: Trabalhador
    texto: "\xC9 pra isso."
  patioAguaRecebida:
  - personagem: Trabalhador
    texto: "Segure firme. \xC9 pouca, mas d\xE1 pra levar."
  - personagem: Zefinha
    texto: Vou levar pra eles.
  patioPanoEntregue:
  - personagem: Zefinha
    texto: Vou deixar dobrado aqui.
  - personagem: Trabalhador
    texto: Obrigado, menina.
  patioInseguranca:
  - personagem: Zefinha
    texto: Eu num sei se isso vai ajudar.
  - personagem: ACOMPANHANTE
    texto: "Leve o que conseguiu. N\xF3s fica perto deles."
  patioLevarAgua:
  - personagem: Zefinha
    texto: "Painho, consegui \xE1gua."
  - personagem: Pai
    texto: "D\xEA primeiro a Bento."
  - personagem: Zefinha
    texto: Seu Bento?
  patioAntesQueda:
  - personagem: Fiscal
    texto: Deixe de demora. Tem mais carro esperando.
  - personagem: Bento
    texto: "Eu num t\xF4 conseguindo\u2026"
  - personagem: Zefinha
    texto: Ele precisa parar.
  - personagem: Pai
    texto: Bento, solte isso!
  patioDepoisQueda:
  - personagem: Pai
    texto: O homem caiu!
  - personagem: Fiscal
    texto: "Cada um no seu servi\xE7o."
  - personagem: Zefinha
    texto: "Mas ele t\xE1 no ch\xE3o!"
  patioPensamentoMari:
  - personagem: "Mari \u2014 pensamento"
    texto: "Eu t\xF4 aqui\u2026"
  - personagem: "Mari \u2014 pensamento"
    texto: "Essa m\xE3o\u2026 \xE9 da bisa."
  - personagem: "Mari \u2014 pensamento"
    texto: "Mas eu t\xF4 sentindo."
  patioReacaoMae:
  - personagem: "M\xE3e"
    texto: Josefa, fique comigo.
  - personagem: Zefinha
    texto: "Mainha, n\xF3s pode ajudar?"
  - personagem: "M\xE3e"
    texto: "Vamos tentar. Traga a \xE1gua."
  patioReacaoLuzia:
  - personagem: Luzia
    texto: Josefa. Olhe pra mim.
  - personagem: Zefinha
    texto: "Ele ainda pode ouvir n\xF3s?"
  - personagem: Luzia
    texto: "Vamos chegar perto. Traga a \xE1gua."
  patioAutorizarPano:
  - personagem: Trabalhador
    texto: "Menina, pegue o pano que tu deixou. Ainda t\xE1 limpo."
