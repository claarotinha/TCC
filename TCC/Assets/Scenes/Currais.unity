  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ExamineObject
  examinePanel: {fileID: 3000000053}
  examineText: {fileID: 3000000061}
  message: "O homem se apoia na carro\xE7a entre um esfor\xE7o e outro. A respira\xE7\xE3o
    demora a se acalmar."
--- !u!114 &9933000052
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4300000086}
